# =============================================================================
# qwen38_flash_next-rank.env.example -- Qwen3.8-Flash-Next-NVFP4, 2-node DGX
# Spark pair (TP=2) served by an aarch64/sm_121 image from build-spark-cu132.sh
# (local-inference-lab/vllm dev/jovian-judgement + B12X/SparkInfer).
#
# EVERY setting is explicit. Each line says what it does, what values are
# accepted, and where the value came from. Empty values are deliberate:
# "empty = the launcher omits the flag and the engine uses its own default".
# The launcher validates every value at --check time.
#
# Source recipe: rtx6kpro/models/qwen38-flash-next/qwen38-flash-next.compose.yml
# (single-node RTX PRO 6000, R35 image). Pair adaptations are commented at
# their lines. Qwen TP2/pair serving is implemented, NOT qualified: no pair
# numbers exist yet; measure before publication. Lines copied from
# glm53-rank.env.example are traps where the value differs (MXFP8_LM_HEAD,
# KDA_PREFILL_BACKEND, BLOCK_SIZE, MAX_NUM_BATCHED_TOKENS) -- each says so.
#
# FORMAT RULES (the file is sourced by the launcher AND passed to --env-file):
#   - plain KEY=VALUE, no quotes; lists comma-separated, never spaces
#   - no JSON -- sourcing strips its quotes; the launcher builds JSON instead
#   - NEVER put a comment after a value: --env-file passes it into the container
#   - <placeholder> in a non-comment line is refused at --check
#
# Copy once per node; only section 1 differs between the two files:
#     cp qwen38_flash_next-rank.env.example rank-0.env   # API node
#     cp qwen38_flash_next-rank.env.example rank-1.env   # headless worker
# Validate: ./qwen38_flash_next_pair_serve.sh --check rank-0.env
# Start rank 1 first (it blocks on rank 0's rendezvous), then rank 0.
# Quick restart with a clean page cache (previous model loads leave page cache
# that counts against CUDA free memory on GB10):
#     ./qwen38_flash_next_pair_serve.sh --fresh rank-0.env
#
# Fill this header when instantiating (publishing checklist):
#   Image:  <tag or immutable digest>
#   Pins:   vLLM <sha> / sparkinfer <sha>   (copy from build.env)
#   Measured: <date>, rank-0 boot on the pin above
# =============================================================================


# =============================================================================
# 1. REQUIRED -- resolve every <placeholder>. Read from THIS host; never copy
#    fabric identity from another machine.
# =============================================================================

# 0 = API node (serves HTTP, coordinates); 1 = headless worker.
NODE_RANK=<0_or_1>

# Rank 0's IPv4 on the ConnectX-7 link. IDENTICAL in both files. The launcher
# dies if it routes through a gateway (a one-digit typo otherwise hangs both
# ranks forever with no error).
MASTER_ADDR=<rank0_fabric_ipv4>

# THIS node's IPv4 on the link. Rank 0: equal to MASTER_ADDR. Must be a local
# address -- this is what catches running the wrong rank's file.
VLLM_HOST_IP=<this_node_fabric_ipv4>

# Snapshot dir of local-inference-lab/Qwen3.8-Flash-Next-NVFP4 holding
# config.json + weights (~109 GB total). Byte-identical on both nodes
# (rsync -c, or hash the files).
MODEL_HOST_PATH=<abs_path_to_model_snapshot>

# Writable JIT/compile cache, at least four directory levels deep (--clear
# wipes it and refuses shallow paths). Holds torch.compile, Triton,
# FlashInfer, B12X artifacts and the RoCEnante proxy. Do NOT set
# XDG_CACHE_HOME / TRITON_CACHE_DIR / VLLM_CACHE_ROOT here -- the compose
# recipe's /cache/jit/qwen38-r281 roots are dropped on purpose; the pair
# image fingerprints them per revision and /cache is mounted from this path.
CACHE_HOST_PATH=<abs_path_to_writable_cache>

# The image built by build-spark-cu132.sh. Same tag or digest on both nodes
# (docker save | docker load keeps image IDs identical). The community
# reference image localinferencelab/vllm:jovian-judgement-community-20260911-r35
# carries the same Qwen runtime, but the pair runs THIS lab's build.
SERVING_IMAGE=<image_tag_or_digest>

#   ip -br link  -> the interface on the CX7 link (NCCL and Gloo must match)
NCCL_SOCKET_IFNAME=<fabric_ifname>
GLOO_SOCKET_IFNAME=<fabric_ifname>
#   ibv_devices  -> the RDMA device; exactly one under the single-rail profile
NCCL_IB_HCA=<rdma_device>
#   show_gids    -> the RoCEv2 IPv4 row's index. The #1 cause of silent NCCL
#   hangs when copied from another machine.
NCCL_IB_GID_INDEX=<rocev2_ipv4_gid_index>


# =============================================================================
# 2. SERVING SHAPE
# =============================================================================

# HTTP port on rank 0 / torch.distributed rendezvous port. Must differ.
# 8000 = the compose default; the GLM-5.3 pair uses 7777, so both can coexist.
API_PORT=8000
MASTER_PORT=29500

# Names clients may send, comma-separated, no spaces. The first is what
# /v1/models reports. The compose serves exactly this name; add a second
# casing only if clients 404 on a mismatch.
SERVED_MODEL_NAME=Qwen3.8-Flash-Next-NVFP4

# Empty = open port (bind is host-local only unless the host is exposed).
# Set to require Authorization: Bearer <key> on rank 0.
API_KEY=

# Speculator: mtp = the in-checkpoint MTP head (the qualified choice); none =
# plain decode. No separate draft checkpoint exists for this model.
SPECULATOR=mtp

# Draft depth. 3 = MTP3, the qualified depth (rtx6kpro doc: three-token MTP).
NUM_SPECULATIVE_TOKENS=3

# Adaptive depth (mtp-family speculators). 0 = fixed depth. Adaptive depth is
# verified for GLM-5.3's mtp only; Qwen support is UNVERIFIED -- leave 0
# unless measuring. INITIAL/WINDOW apply only when =1.
ADAPTIVE_SPECULATIVE_TOKENS=0
ADAPTIVE_SPECULATIVE_TOKENS_INITIAL=3
ADAPTIVE_SPECULATIVE_TOKENS_WINDOW=32

# MTP head backends. The compose puts moe_backend b12x INSIDE the speculative
# config (GLM-5.3 uses humming -- do not copy that value here).
MTP_MOE_BACKEND=b12x
MTP_ATTENTION_BACKEND=B12X

# Separate draft checkpoint; mtp needs none. Empty on every qualified boot.
DRAFT_MODEL_HOST_PATH=
DRAFT_WEIGHTS_SHA256=

# Context ceiling. 262144 = the checkpoint's max_position_embeddings and the
# compose value. Never `auto` (resolves to the checkpoint maximum and
# starves the pool). One request of this length must fit the KV pool below.
MAX_MODEL_LEN=262144

# Concurrent sequences. A decode step is MAX_NUM_SEQS x (depth+1) = 16 x 4 =
# 64 tokens and fits MAX_CUDAGRAPH_CAPTURE_SIZE=64 exactly. Raising both
# together costs ~2 GiB more graph memory.
MAX_NUM_SEQS=16

# Tokens per engine step = prefill chunk. 8192 (raised from the compose's
# 6019, 2026-09-13): the engine warned three times that
# max_num_scheduled_tokens=6019 is suboptimal under MTP3. Costs a larger
# transient activation peak (comes out of the KV pool -- re-read the pool
# line before pinning) and recompiles the piecewise graph (the compile
# range endpoint was 6019). Never inherit 4096 from the GLM file.
MAX_NUM_BATCHED_TOKENS=8192

# Largest captured decode batch. 64 covers the full 16 x 4 decode step.
MAX_CUDAGRAPH_CAPTURE_SIZE=64

# FULL_AND_PIECEWISE adds piecewise prefill graphs (~2 GiB static) -- the
# compose compilation-config value.
CUDAGRAPH_MODE=FULL_AND_PIECEWISE

# Prefix cache reuse / chunked long prefills. Both qualified for Qwen.
ENABLE_PREFIX_CACHING=1
ENABLE_CHUNKED_PREFILL=1

# 0 = --no-enable-flashinfer-autotune (the compose value). B12X owns
# attention, MoE and linear, so there is nothing of consequence to tune.
ENABLE_FLASHINFER_AUTOTUNE=0

# 0: the fork serves this model natively; the compose sets no trust flag.
TRUST_REMOTE_CODE=0

# Public block-table unit. 64 = the compose/R33 value (requested 64, measured
# effective hybrid pages 3008 tokens; the recipe does not force a different
# geometry). Hybrids override the physical page anyway. GLM's 256 is the
# wrong value here.
BLOCK_SIZE=64

# --- prefill/decode contention: two alternative answers, use one ----------
# Empty on every qualified Qwen boot (the compose omits them). The GLM pair
# runs PREFILL_SCHEDULE_INTERVAL=8 -- an unmeasured A/B candidate here, not
# the default.
PREFILL_SCHEDULE_INTERVAL=
FAIRNESS_ENGINE=
PREFILL_COMPUTE_SHARE=

# Recurrent-state retention for prefix caching -- this IS a hybrid model
# (36 linear_attention/GDN layers + 12 full_attention layers). Empty = the
# compose behavior (engine auto default: request_boundaries where supported).
# Set request_boundaries explicitly to pin it; aligned for long-document
# prefix reuse (costs more retained recurrent states).
RECURRENT_CHECKPOINT_POLICY=


# =============================================================================
# 3. MEMORY
# =============================================================================

# Pinned KV(+recurrent) pool in bytes. EMPTY UNTIL MEASURED: boot once with
# this empty, read "Available KV cache memory" from the rank-0 log, pin that
# (bring-up order at the file tail). Never carry a number over from another
# model; the recurrent state shares this reservation.
KV_CACHE_MEMORY_BYTES=

# Inert while the pin is set; governs pool sizing only if the pin is removed.
# GB10 unified memory: ~121.7 GiB total, ~10.5 GiB held by the OS, so vLLM
# refuses above ~0.913. The compose's 0.96 is the 96 GB RTX PRO 6000 value --
# NOT valid here.
GPU_MEMORY_UTILIZATION=0.90

# fp8 is the qualified KV layout for B12X QSA attention (choices: fp8|auto).
# The DeepSeek packed layouts (fp8_ds_mla, nvfp4_ds_mla) are not offered:
# unverified against QSA.
KV_CACHE_DTYPE=fp8

# Host free-memory gate at --check: die (default) refuses when MemFree is
# short of what vLLM's own startup gate reads; warn proceeds; off skips.
# Only runs in profiling mode (no KV pin). With PLE offload on, ~24 GiB of
# host RAM is CUDA-mapped on top of this.
MEM_PREFLIGHT=die

# cgroup cap so a runaway load kills the container, not the host. Empty =
# unlimited. On GB10 this counts the GPU-visible allocation too.
CONTAINER_MEMORY_GB=


# =============================================================================
# 4. MULTIMODAL -- the checkpoint is vision-language; this pair ships vision ON
# =============================================================================

# 0 = serve images AND video (the checkpoint has image_token_id 248056 and
# video_token_id 248057; the compose's text-only --language-model-only is
# deliberately not carried to the pair). 1 would skip the vision encoder
# cache and profile item.
LANGUAGE_MODEL_ONLY=0

# 0 = uncapped (engine default: 999 per modality) -- deliberate on a pair:
# TP2's ~243 GiB unified memory removes the preprocessing/host-RAM pressure
# the cap exists to bound, and the profiling dummy prompt is one max-size
# image item regardless (2026-09-13 boot: "profiled with 1 image items of
# the maximum feature size"). The launcher warns LIMIT_MM=0 only while the
# KV pin is unset.
LIMIT_MM=0

# Per-prompt caps, read only when LIMIT_MM=1 (integers on purpose). Left
# commented with values: 16 images is the GLM/DS pair convention; 2 videos,
# but video on the pair is UNVERIFIED (temporal_patch_size 2).
#MM_IMAGES=16
#MM_VIDEOS=2

# Host-RAM cache of PREPROCESSED media. The compose sets 0 and on unified
# memory the engine default (4 GiB per process, x2 processes) is the same
# pool as KV. 0 disables it; prompts are unaffected, only repeated media is
# reprocessed.
MM_PROCESSOR_CACHE_GB=0

# data = each rank holds the full encoder and encodes its own items (no
# encoder collectives over RoCE). The compose value for TP2.
MM_ENCODER_TP_MODE=data


# =============================================================================
# 5. KERNELS AND BACKENDS
# =============================================================================

# GB10 is sm_121. The launcher refuses anything else: sm_120a silently builds
# RTX Pro 6000 CuTeDSL kernels that compile and then fail at load.
CUTE_DSL_ARCH=sm_121a
FLASHINFER_CUDA_ARCH_LIST=12.1f

# Kernel backends, explicit (compose --linear-backend/--moe-backend; B12X
# attention is what the engine selects for QSA). b12x/B12X is the sparkinfer
# set this image is built for; auto may select FlashInfer kernels not
# qualified on sm_121.
MOE_BACKEND=b12x
ATTENTION_BACKEND=B12X
LINEAR_BACKEND=b12x

# Quantization config class: modelopt_mixed (compose --quantization; the
# checkpoint is ModelOpt MIXED_PRECISION: MXFP8 attention linears, NVFP4
# routed experts, W4A16_NVFP4 MTP expert layers and visual fc2).
QUANTIZATION=modelopt_mixed

# GDN prefill backend -- HYBRID MODELS ONLY. TRAP: Qwen's Gated DeltaNet
# recurrent prefill is FlashInfer BY DESIGN ("not GLM's FlashKDA backend").
# glm53-rank.env.example sets flashkda -- never copy that here. Empty = omit
# the flag, engine default (FlashInfer).
KDA_PREFILL_BACKEND=

# GDN decode kernel. b12x pins it explicitly (compose --gdn-decode-kernel
# b12x). Other values: empty (engine resolver), cuda, triton.
GDN_DECODE_KERNEL=b12x

# 0 = FP4-activation MoE (qualified, engine default); 1 = the older W4A16
# path for an output-quality A/B.
VLLM_B12X_MOE_FP4_FORCE_A16=0

# B12X kernel-policy engine: auto = GPU profile when a GB10 entry exists,
# heuristic otherwise.
B12X_POLICY_MODE=auto

# --- Qwen head / PLE / runtime toggles (all from the compose recipe) -------
# Target vocabulary head BF16 (the compose value). TRAP: GLM runs 1 -- the
# launcher dies on 1 for this model.
VLLM_MXFP8_LM_HEAD=0
# Private NVFP4 copy of the head for the MTP draft.
VLLM_MTP_NVFP4_LM_HEAD=1
# BF16 draft-head activations: W4A16, not W4A4. The launcher dies on 0:
# value zero produced near-zero MTP draft acceptance at C8/C16 in three
# diagnostic sweeps; one restored it.
VLLM_LM_HEAD_A16=1
# Qwen-specific MTP path toggles (compose values).
VLLM_QWEN3_8_FLASH_NEXT_MTP_COMPACT=1
VLLM_QWEN3_8_FLASH_NEXT_OVERLAP=1
# Share GDN query/count metadata across layers per step (less per-step CPU).
VLLM_GDN_SPEC_DECODE_METADATA_FASTPATH=1
# PLE n-gram embedding table (ple_layer_ids [2], ~24 GiB nvfp4). Explicit
# storage selector (envs.py choices: ram|disk; additional_config
# ple_table_memory device|ram|disk overrides both vars below).
VLLM_PLE_TABLE_MEMORY=ram
# Legacy fallback, kept: 1 = CUDA-mapped host RAM (the qualified value, the
# 2026-09-13 boot's 13.41 GiB per rank); 0 = device-resident, implemented
# NOT qualified -- the table returns to GPU memory and invalidates the KV
# pin (re-profile).
VLLM_PLE_CPU_OFFLOAD=1
# Marlin serves the NVFP4 linears --linear-backend b12x cannot (MTP expert
# layers, visual fc2); 1 = the 2026-09-13 boot log's recommendation for
# small size_n (atomic-add accumulation). Experimental.
VLLM_MARLIN_USE_ATOMIC_ADD=1
# Marlin FP8 scaled-MM is not qualified on sm_121 (compose value).
VLLM_DISABLED_KERNELS=MarlinFP8ScaledMMLinearKernel
# Hoist the causal-conv1d update (compose value).
VLLM_CAUSAL_CONV1D_UPDATE_HOIST=1
# GDN conv/SSM state layout (compose value).
VLLM_SSM_CONV_STATE_LAYOUT=DS
# V2 model runner; skip NaN-in-logits compute (compose values).
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_COMPUTE_NANS_IN_LOGITS=0
# 1: the memory profiler counts captured-graph memory, so the KV pool line
# it reports (and any pin taken from it) is post-capture honest. The compose
# sets 0; the 2026-09-13 boot answered with a warning that graphs were
# unaccounted. Set BEFORE the profiling boot.
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=1

# --- B12X dynamic MoE set (compose values) ---------------------------------
# The PCIE_ONESHOT_* knobs configure the single-node PCIe all-reduce kernel:
# INERT on the pair (VLLM_ENABLE_PCIE_ALLREDUCE=0 below), carried for recipe
# parity. Note: TP2's width-320 expert partition (hc_lowrank 320) is not
# split-tile eligible, so the SPLIT_* path is not taken at TP2; the knobs are
# kept because the compose recipe sets them.
B12X_DENSE_ACTIVATION_MODE=auto
B12X_DYNAMIC_SPLIT_ROUTE_COMPUTE=1
B12X_DYNAMIC_DIRECT_EXPERT_SCALES=1
B12X_DYNAMIC_SPLIT_LOW_SMEM=1
B12X_DYNAMIC_SKIP_SPLIT_BARRIER_RESET=1
B12X_DYNAMIC_SPLIT_FAST_PREPARE=1
B12X_DYNAMIC_WORK_SOURCE=persistent_grid
B12X_DYNAMIC_DETERMINISTIC_OUTPUT=0
B12X_DYNAMIC_SPLIT_COMPUTE_MAC=224
B12X_DENSE_SPLITK_TURBO=1
B12X_PCIE_ONESHOT_THREADS=512
B12X_PCIE_ONESHOT_BLOCK_LIMIT=4
B12X_PCIE_ONESHOT_PDL=1
B12X_MHC_PDL=1

# torch.compile level: empty = none (CUDA graphs only, the qualified path);
# 0-3 passes -O<N>. A/B only.
COMPILATION_LEVEL=

# Sampling defaults: auto = the checkpoint's generation_config.json, which
# carries the publisher's qualified sampling -- temperature 1.0, top_p 0.95,
# top_k 20 (verified against HF 2026-09-12). What every Qwen benchmark in the
# doc ran under. Per-request sampling fields still win.
GENERATION_CONFIG=auto

# Sampling overrides -- empty: GENERATION_CONFIG=auto already resolves to the
# publisher's 1.0/0.95/20. Set these only to deviate deliberately.
SAMPLING_TEMPERATURE=
SAMPLING_TOP_P=
SAMPLING_TOP_K=
SAMPLING_MIN_P=
SAMPLING_REPETITION_PENALTY=

# Non-thinking requests are per-request:
#   "chat_template_kwargs":{"enable_thinking":false}
# Empty = the checkpoint's own chat template.
CHAT_TEMPLATE_HOST_PATH=

# Host dir for torch profiler traces; empty = disabled. Set to enable POST
# /start_profile and /stop_profile (mounted at /profiles). Traces are large.
TORCH_PROFILE_HOST_DIR=


# =============================================================================
# 6. COLLECTIVES
# =============================================================================

# RoCEnante: routes TP all-reduces <= ALLREDUCE_MAX_SIZE and all-gather shards
# <= ALLGATHER_MAX_SIZE through b12x.comm.roce; NCCL keeps the rest. 16 MiB is
# the pair-qualified value (Dooner's TP2 profile uses it); note the 8192-token
# chunk's per-layer reduce here is 8192 x 2560 x 2 B ~= 41 MiB, so prefill
# reduces stay on NCCL -- raising the cutoff is a re-measure candidate, not
# the default. The proxy compiles at first boot into B12X_ROCE_CACHE_DIR
# (keep it under /cache or it recompiles every boot).
VLLM_ENABLE_ROCE_ALLREDUCE=1
VLLM_ROCE_ALLREDUCE_MAX_SIZE=16777216
VLLM_ROCE_ALLGATHER_MAX_SIZE=16777216
B12X_ROCE_CACHE_DIR=/cache/jit/b12x-roce

# The B12X PCIe allreduce is a single-node PCIe P2P path -- the compose sets
# 1 for the RTX box. On a pair every TP allreduce crosses the CX7 link; this
# overrides to 0 and the launcher REFUSES 1.
VLLM_ENABLE_PCIE_ALLREDUCE=0


# =============================================================================
# 7. LOADER AND RUNTIME
# =============================================================================

# instanttensor (~2.4 GB/s on Spark NVMe) is the qualified loader (compose
# --load-format). Others: fastsafetensors, auto, safetensors, and b12x (needs
# VLLM_PLUGINS=b12x_loader).
LOAD_FORMAT=instanttensor

# InstantTensor-ONLY staging bounds. BUFFER_SIZE must exceed the checkpoint's
# largest tensor or the loader enlarges it on every boot: GLM's same-width
# expert tensor is 1,268,776,960 B -- confirm the largest tensor's byte count
# in the first load log and raise on BOTH rank files if auto-enlarged.
INSTANTTENSOR_BUFFER_SIZE=1342177280
INSTANTTENSOR_IO_DEPTH=3
INSTANTTENSOR_CONCURRENCY=1
INSTANTTENSOR_CHUNK_SIZE=8388608
INSTANTTENSOR_BACKEND=BUFFERED
# auto = engine default. 0/1 are rejected by pins >= 6575b5ac (the option was
# removed; use LOAD_FORMAT=fastsafetensors instead).
INSTANTTENSOR_COPY=auto
SAFETENSORS_FAST_GPU=1

# Fully offline: the model resolves from the mount only.
HF_HOME=/root/.cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
VLLM_NO_USAGE_STATS=1

# Empty = no plugins. Set b12x_loader only with LOAD_FORMAT=b12x.
VLLM_PLUGINS=
# fork + CUDA is unsafe; spawn is required.
VLLM_WORKER_MULTIPROC_METHOD=spawn

# Compat shim FIRST (image kernels are CUDA 13.2; the host driver exports
# older -- without it every process dies at import with "undefined symbol:
# cuTensorMapEncodeTiled"), then the patched NCCL for the switchless pair.
# The launcher verifies both paths exist inside the image.
LD_PRELOAD=/usr/local/cuda/compat/libcuda.so.1:/opt/libnccl-local-inference.so.2.30.4
VLLM_NCCL_SO_PATH=/opt/libnccl-local-inference.so.2.30.4
NCCL_LOCAL_INFERENCE_PATH=/opt/libnccl-local-inference.so.2.30.4
NCCL_PR2127_PATH=/opt/libnccl-local-inference.so.2.30.4
TORCH_USE_RTLD_GLOBAL=1

# JIT toolchain: Triton uses the image's CUDA 13.2 ptxas, not its bundled one.
CUDA_HOME=/usr/local/cuda
TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas

# Allocator: expandable segments, required alongside NCCL_CUMEM_ENABLE=0.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_DEVICE_MAX_CONNECTIONS=32

# Grace CPU threads for torch. 2 avoids torch's spin-wait warning under
# serving; upstream's TP2 launcher uses 16 (difference unmeasured).
OMP_NUM_THREADS=2

# docker or podman.
CONTAINER_RUNTIME=docker
# Optional suffix so two env files can run side by side on one host (A/B).
CONTAINER_NAME_SUFFIX=


# =============================================================================
# 8. FABRIC -- RoCEv2 over the direct link; launcher-enforced
# =============================================================================

# single = ONE cable between the nodes (the launcher then requires the two
# knobs below at 0 and a single device in NCCL_IB_HCA). dual = BOTH CX7 ports
# cabled node-to-node: set MERGE_NICS=1, SUBNET_AWARE_ROUTING=1 and list both
# rails in NCCL_IB_HCA for ~2x cross-node bandwidth.
FABRIC_PROFILE=single

# RoCE presents IB semantics over Ethernet: IB is correct. The image bakes
# NCCL_IB_DISABLE=1 for single-node boxes; this overrides it, and without the
# override the pair silently falls back to TCP sockets.
NCCL_NET=IB
NCCL_NET_PLUGIN=none
NCCL_IB_DISABLE=0

# Single-rail: 0/0 (validated).
NCCL_IB_SUBNET_AWARE_ROUTING=0
NCCL_IB_MERGE_NICS=0

# Qualified protocol/topology set for the direct-cable pair. The compose's
# single-node channel tuning (NCCL_MIN_NCHANNELS/MAX_NCHANNELS=16,
# NCCL_BUFFSIZE=2097152) is deliberately NOT carried over: unmeasured
# cross-node.
NCCL_PROTO=LL,LL128,Simple
NCCL_P2P_LEVEL=SYS
NCCL_CROSS_NIC=1

# NCCL's CUDA VMM allocator conflicts with expandable_segments: keep 0.
NCCL_CUMEM_ENABLE=0

# Grace's unified layout defeats NCCL's NUMA guesses.
NCCL_IGNORE_CPU_AFFINITY=1

# WARN for serving. INFO names the transport per channel (NET/IB vs
# NET/Socket) when debugging a hang or confirming RoCE is in use.
NCCL_DEBUG=WARN


# =============================================================================
# BRING-UP ORDER (once per model + pin; record the numbers in the header)
#
# 1. Profile: KV_CACHE_MEMORY_BYTES empty, GPU_MEMORY_UTILIZATION 0.90, MTP3
#    as configured. On GB10 CUDA free memory tracks MemFree -- if the
#    preflight names stale page cache, use --fresh (drop caches + run +
#    follow logs) or sync && echo 3 | sudo tee /proc/sys/vm/drop_caches.
# 2. From the rank-0 log take: "Available KV cache memory" -> the byte pin;
#    "GPU KV cache size: N tokens" -> must exceed 262144; "Maximum
#    concurrency for L tokens" -> real concurrency. Trust the engine's
#    logical-capacity line: the R33 doc says a nominal
#    physical-blocks-times-page calculation (~13.1M) is NOT usable capacity
#    for this hybrid cache.
# 3. Pin the bytes, then confirm the pool line did not move.
# 4. MAX_NUM_SEQS x (depth+1) = 16 x 4 = 64 = MAX_CUDAGRAPH_CAPTURE_SIZE (fits
#    exactly; raising either costs graph memory).
# 5. --verify on BOTH ranks: confirm the B12X QSA/indexer, GDN decode, PLE
#    offload and RoCEnante lines are in the log. A server that answers
#    /health can still be on a fallback path.
# 6. Change ONE knob per boot.
# 7. Any change of speculator, vision mode, PLE offload, loader, or pin
#    invalidates 2-4: re-measure. A benchmark JSON and an env file describing
#    different boots must never be published together.
# =============================================================================
