# =============================================================================
# deepseekv4vision-rank.env.example -- DeepSeek-V4-Flash-Vision-Exp on a
# 2-node DGX Spark pair (TP=2), served by an aarch64/sm_121 image from
# build-spark-cu132.sh (local-inference-lab/vllm dev/karmic-kraken @ 57fdda71
# + local-inference-lab/b12x @ 8a99d639 -- the kk-beta-cu132 profile; kk-beta
# nomenclature until Luke confirms the r1 tag scheme).
# Launcher: deepseek_v4_vision_pair_serve.sh
#
# Checkpoint: deepseek-ai/DeepSeek-V4-Flash-Vision-Exp @ 6821d6a (168 GB,
#   43 layers, fp8 dense + fp4 experts, DSpark draft in-checkpoint, 32-layer
#   ViT, <= 387 context tokens per image, images only).
# Image:  <tag or immutable digest>   (karmic-kraken-beta-cu132, kk-beta
#         lineage)
# Pins:   vLLM 57fdda71 / b12x 8a99d639 (build-kk-beta-cu132.env; the pins
#         carry the KK memory fixes -- #809 checkpoint-aware KV admission
#         rejects pools that cannot restore checkpoints, #801/#803/#798
#         memory reclaims, #805 NVFP4 loader fix)
# Measured: NOTHING YET. Every serving value below names its source; values
#   marked "upstream" come from scripts/serve-ds4-flash-dspark-tp2-rdma.sh
#   (2026-09-02) or the HF model card and are unmeasured on this pair.
#   Replace them with measured numbers as the bring-up order at the end
#   produces them, and record the boot date here.
#
# EVERY setting is explicit. For keys the LAUNCHER consumes, empty means "omit
# the flag; engine default". Engine-read variables (VLLM_*, B12X_*, NCCL_* ...)
# must carry a value or be absent: --env-file passes KEY= into the container
# as an empty string, and the launcher refuses such lines.
#
# FORMAT RULES (the file is sourced by the launcher AND passed to --env-file):
#   - plain KEY=VALUE, no quotes; lists comma-separated, never spaces
#   - no JSON -- sourcing strips its quotes; the launcher builds JSON instead
#   - NEVER put a comment after a value: --env-file passes it into the container
#   - <placeholder> in a non-comment line is refused at --check
#
# Copy once per node; only section 1 differs between the two files:
#     cp deepseekv4vision-rank.env.example rank-0.env   # API node
#     cp deepseekv4vision-rank.env.example rank-1.env   # headless worker
# Validate: ./deepseek_v4_vision_pair_serve.sh --check rank-0.env
# Start rank 1 first (it blocks on rank 0's rendezvous), then rank 0.
# =============================================================================


# =============================================================================
# 1. REQUIRED -- resolve every <placeholder>. Read from THIS host; never copy
#    fabric identity from another machine.
# =============================================================================

# 0 = API node (serves HTTP, coordinates); 1 = headless worker.
NODE_RANK=<0_or_1>

# Rank 0's IPv4 on the ConnectX-7 link. IDENTICAL in both files. The launcher
# dies if it routes through a gateway.
MASTER_ADDR=<rank0_fabric_ipv4>

# THIS node's IPv4 on the link. Rank 0: equal to MASTER_ADDR. Must be a local
# address -- this is what catches running the wrong rank's file.
VLLM_HOST_IP=<this_node_fabric_ipv4>

# Snapshot dir holding config.json + 48 safetensors shards. Byte-identical on
# both nodes (verify shard SHA-256 against the HF blob names). Keep it on
# local NVMe: the load is NVMe-bound (~2.5 GB/s), never serve weights over
# the fabric.
MODEL_HOST_PATH=<abs_path_to_model_snapshot>

# Writable JIT/compile cache, at least four directory levels deep (--clear
# wipes it and refuses shallow paths). Do NOT set XDG_CACHE_HOME /
# TRITON_CACHE_DIR / VLLM_CACHE_ROOT here -- the image fingerprints them per
# revision. Use a directory distinct from the GLM cache.
CACHE_HOST_PATH=<abs_path_to_writable_cache>

# The image both nodes carry (docker save | docker load keeps IDs identical).
# Prefer an immutable digest once one exists.
SERVING_IMAGE=<image_tag_or_digest>

#   ip -br link  -> the interface on the CX7 link (NCCL and Gloo must match)
NCCL_SOCKET_IFNAME=<fabric_ifname>
GLOO_SOCKET_IFNAME=<fabric_ifname>
#   ibv_devices  -> the RDMA device; exactly one under the single-rail profile
NCCL_IB_HCA=<rdma_device>
#   show_gids    -> the RoCEv2 IPv4 row's index. Read it on THIS hardware.
NCCL_IB_GID_INDEX=<rocev2_ipv4_gid_index>


# =============================================================================
# 2. SERVING SHAPE
# =============================================================================

# HTTP port on rank 0 / torch.distributed rendezvous port. Must differ.
API_PORT=8000
MASTER_PORT=29500

# The name clients send and /v1/models reports. (The launcher also accepts a
# comma-separated alias list for clients that 404 on a case mismatch; one
# name is enough here.)
SERVED_MODEL_NAME=DeepSeek-V4-Flash-Vision-Exp

# Empty = open port. Set to require Authorization: Bearer <key> on rank 0.
API_KEY=

# dspark = the parallel block drafter that ships INSIDE this checkpoint (the
# mtp.* tensors; no separate weights, nothing to hash). none = plain decode.
# source: HF model card vLLM recipe; upstream TP2 launcher.
SPECULATOR=dspark

# Draft depth. HF card serves Vision-Exp at 3 ("K3") with adaptive
# verification; upstream text launcher runs 7 on 0731. Depth is free on
# DeepSeek-V4 at this pin (the block_size-equality rule is Qwen3-only), so
# the 0731-era ">= 5 or wrong output" floor no longer applies. Unmeasured on
# this pair: A/B 3 vs 5 vs 7 under adaptive verification.
NUM_SPECULATIVE_TOKENS=3

# probabilistic = draft samples from its distribution and adaptive
# verification scores the per-position confidences (HF card, upstream).
# greedy = one-hot draft; higher raw acceptance, nothing for adaptive
# verification to trim. Launcher warns on greedy+adaptive.
DSPARK_DRAFT_SAMPLE_METHOD=probabilistic

# Rejection sampling for the DSpark verify step. [KK published contract]
# standard = per-position ratio test (what probabilistic + adaptive was
# qualified with); other values: block, synthetic. The engine default is
# greedy -- every JJ-era measurement here ran greedy rejection too.
DSPARK_REJECTION_SAMPLE_METHOD=standard

# 1 = the engine sizes each request's verify budget from draft confidence
# (HF card: enable_adaptive_verification true). Requires an attention backend
# that accepts device-trimmed query lengths; the B12X DSV4 attention, SWA and
# indexer backends do (b12x_indexer.py opts in). 0 = verify a fixed depth.
DSPARK_ADAPTIVE_VERIFICATION=1

# No separate draft for this model; the launcher never reads these.
DRAFT_MODEL_HOST_PATH=
DRAFT_WEIGHTS_SHA256=

# Context ceiling. Checkpoint max is 1,048,576 (YaRN x16 over 65,536).
# Bring-up value = upstream 500,000 rounded to a 256-block multiple; one
# request of this length must fit the pool the first (profiling) boot
# reports. Raise toward 1048576 only after reading "GPU KV cache size".
MAX_MODEL_LEN=1048576

# Concurrent sequences. One decode step = MAX_NUM_SEQS x (depth+1) tokens
# = 8 x 4 = 32, which is exactly MAX_CUDAGRAPH_CAPTURE_SIZE below.
# upstream TP2 runs 4; the 0731 pair ran 16 at capture 96.
MAX_NUM_SEQS=8

# Tokens per engine step = prefill chunk. upstream 8192. Measured on the 0731
# pair: 16384 gave no prefill/decode gain and cut the usable pool ~38%
# (indexer and context-KV buffers scale with the batch). Under a pinned byte
# count the pool line moves with this value -- re-read it after any change.
MAX_NUM_BATCHED_TOKENS=8192

# Largest captured decode batch. Set to one full step (32) so the largest
# real batch replays from a graph; the launcher emits a DENSE capture list
# (1,2,3,4,8,...,32) so every verify depth is its own bucket (upstream
# rationale: coarse pow2 buckets misprice mid-depth pruning).
MAX_CUDAGRAPH_CAPTURE_SIZE=32

# upstream DSV4 recipes. FULL_AND_PIECEWISE: full graphs for decode/verify,
# piecewise for prefill. The DSpark drafter captures FULL graphs of its own
# (backbone forward + Markov sampling) regardless.
CUDAGRAPH_MODE=FULL_AND_PIECEWISE

# Prefix cache reuse / chunked long prefills. Both 1 on every upstream recipe.
# Note: the vision path prefills each image span atomically
# (disable_chunked_mm_input) -- expected, not a regression.
ENABLE_PREFIX_CACHING=1
ENABLE_CHUNKED_PREFILL=1

# Async scheduling: overlap scheduling with prefill (the ds4-vision upstream
# profile runs it; the KK profiles list it among their defaults). 1 = pass
# --async-scheduling. [KK]
ASYNC_SCHEDULING=1

# Periodic SWA prefix-cache checkpoints. [KK] --prefix-cache-retention-
# interval N retains, in ADDITION to the semantic checkpoints (replay
# boundary + shared-prefix junctions), a checkpoint every N tokens (must be
# a BLOCK_SIZE multiple) on the sliding-window/Mamba cache groups -- DS4
# attention carries SWA groups, so this applies. Engine default 0 =
# semantic-only. The upstream ds4-vision profile runs 4096: finer prefix
# restoration granularity for long shared-document/agent contexts at the
# cost of retained checkpoint state. Empty = engine default; A/B 4096.
PREFIX_RETENTION_INTERVAL=

# 1: the deepseek_v4 tokenizer and config classes ship with the checkpoint.
TRUST_REMOTE_CODE=1

# Public block-table unit; the DSV4 attention picks its own physical page
# sizes (MLA latent, SWA, indexer) inside it. upstream 256.
BLOCK_SIZE=256

# --- prefill/decode contention: two alternative answers, use one ----------
# Admit new prefill only every N engine steps (vLLM PR #546). Empty = omitted.
# Unmeasured on DSV4; --async-scheduling already overlaps scheduling.
PREFILL_SCHEDULE_INTERVAL=
# Compute-share scheduler instead (a8893b7, 2026-09-04): compute_share with
# PREFILL_COMPUTE_SHARE=0.40, or micro_slicing. Empty = off.
FAIRNESS_ENGINE=
PREFILL_COMPUTE_SHARE=

# HYBRID/RECURRENT MODELS ONLY. DeepSeek-V4 is pure attention: leave empty.
RECURRENT_CHECKPOINT_POLICY=


# =============================================================================
# 3. MEMORY
#
# Budget per rank: ~121.7 GiB unified, ~10.5 GiB held by the OS, ~84 GiB of
# weights at TP=2 (168 GB checkpoint), plus the replicated ViT+aligner, the
# 3-layer draft, activations and graphs. What is left is the KV pool.
# =============================================================================

# Pinned KV pool in bytes. EMPTY for the first boot: vLLM profiles at
# GPU_MEMORY_UTILIZATION and logs "Available KV cache memory" -- pin THAT
# number, measured with vision on (LANGUAGE_MODEL_ONLY=0) and the speculator
# as intended. The 0731 text pin (16.7e9) is NOT transferable: different
# checkpoint, different KV allocation code (compact index-page planning).
# (Prior guess 19327352832 = exactly 18 GiB -- a hand-set placeholder, never
# boot-validated; and KK changed the admission math again: #809 reserves
# checkpoint/endpoint blocks in the pool, #798/#801/#803 freed ~3+ GB of
# probes on the GLM path -- re-profile from scratch on KK.)
KV_CACHE_MEMORY_BYTES=

# Profiling fraction; inert once the pin above is set. upstream TP2 0.82.
# GB10 refuses above ~0.913 (free memory), and page cache from a previous
# model load counts against CUDA free memory (the launcher names it).
GPU_MEMORY_UTILIZATION=0.82

# fp8 -> the B12X DSV4 attention derives DeepSeek's packed ds_mla layout
# (log: "Using DeepSeek's fp8_ds_mla KV cache format"). auto = BF16 latent.
KV_CACHE_DTYPE=fp8

# Host free-memory gate at --check (profiling mode only): die | warn | off.
MEM_PREFLIGHT=die

# cgroup cap. Empty = unlimited (decision D7, 2026-09-10). upstream uses 108.
CONTAINER_MEMORY_GB=


# =============================================================================
# 4. MULTIMODAL -- honoured because the launcher sets MODEL_MULTIMODAL=1
# =============================================================================

# 0 = vision ON: the ViT + aligner load and the profiler includes MM_IMAGES
# max-size images. 1 = text-only: the tower's weights are dropped at load
# (limit 0 -> image_enabled false), not merely skipped in profiling.
# Re-measure the KV pin after switching.
LANGUAGE_MODEL_ONLY=0

# 1 = cap items per PROMPT (the whole chat history counts); 0 = engine
# default 999 per modality. With the KV pin set the cap governs per-request
# preprocessing, encoder work and context only.
LIMIT_MM=0

# Per-prompt image cap. Commented out on purpose (decision D5, 2026-09-10):
# the launcher's default is 16, i.e. at most 16 x 387 = 6,192 context tokens
# of image sentinels per prompt. Uncomment to change; 0 disables images.
#MM_IMAGES=16

# This checkpoint has NO video modality; the launcher refuses anything but 0.
MM_VIDEOS=0

# Host-RAM cache of preprocessed media (engine default 4 GiB per process). On
# unified memory that is KV memory; 0 disables it. Per-image preprocessing
# here is a resize + 14px patchify -- cheap to redo.
MM_PROCESSOR_CACHE_GB=1

# Empty = engine default (weights): the ViT's attention/MLP are TP-sharded and
# every one of its 32 layers runs a collective over RoCE per image batch.
# data = each rank keeps the full tower (~0.5 GB more per rank) and encodes
# its own items with no encoder collectives. Unmeasured; obvious A/B on a
# pair. Vision head count 16 is divisible by TP=2, so both modes are legal.
MM_ENCODER_TP_MODE=


# =============================================================================
# 5. KERNELS AND BACKENDS
# =============================================================================

# GB10 is sm_121. The launcher refuses anything else.
CUTE_DSL_ARCH=sm_121a
FLASHINFER_CUDA_ARCH_LIST=12.1f

# B12X is the only enum the DeepSeek-V4 layer maps to its sparkinfer attention
# class (sparse MLA + SWA + Lightning indexer). The 0731-era value
# B12X_MLA_SPARSE no longer exists on this branch; the launcher refuses it.
ATTENTION_BACKEND=B12X
MOE_BACKEND=b12x
LINEAR_BACKEND=b12x

# upstream DSV4 recipes pass --enable-flashinfer-autotune (FlashInfer still
# owns sampling on this path: VLLM_USE_FLASHINFER_SAMPLER below).
ENABLE_FLASHINFER_AUTOTUNE=1

# KDA/GDN prefill and decode kernels -- HYBRID MODELS ONLY, empty here.
KDA_PREFILL_BACKEND=
GDN_DECODE_KERNEL=

# torch.compile level: empty = CUDA graphs only (upstream path). A/B only.
COMPILATION_LEVEL=

# auto = the checkpoint's generation_config.json; the HF card evaluates at
# temperature 1.0 / top_p 0.95 with reasoning effort max.
GENERATION_CONFIG=auto

# Sampling overrides via --override-generation-config. Empty = leave the
# checkpoint's values alone. Per-request fields still win.
SAMPLING_TEMPERATURE=
SAMPLING_TOP_P=
SAMPLING_TOP_K=
SAMPLING_MIN_P=
SAMPLING_REPETITION_PENALTY=

# Chat-template defaults the launcher passes as --default-chat-template-kwargs
# (built as JSON there). true|false and low|medium|high|max. Per-request wins.
DEEPSEEK_THINKING=true
DEEPSEEK_REASONING_EFFORT=high

# Optional custom chat template (.jinja), mounted read-only. Empty = checkpoint's.
CHAT_TEMPLATE_HOST_PATH=

# Host dir for torch profiler traces; empty = disabled.
TORCH_PROFILE_HOST_DIR=

# --- b12x-side knobs (upstream TP2 values) ---------------------------------
# B12X_POLICY_MODE: RETIRED at b12x 77351c13 (2026-09-13). b12x.policy and
# the embedded GB10 device-profile registry are gone; kernel selection is now
# the preparation lifecycle (measured search at startup). Nothing reads the
# key on r39+. The startup search lever is B12X_AUTOTUNE below.
B12X_AUTOTUNE=1
# Split-K with atomic BF16 accumulation for dense GEMMs (b12x default 1).
B12X_DENSE_SPLITK_TURBO=1

# --- vLLM-side knobs (registered in envs.py at this pin; upstream values) ---
# V2 model runner: the only runner the DSpark speculator and adaptive
# verification are implemented on. upstream sets 1.
VLLM_USE_V2_MODEL_RUNNER=1
# AOT torch.compile artifacts + one mega artifact under /cache (faster reboots).
VLLM_USE_AOT_COMPILE=1
VLLM_USE_MEGA_AOT_ARTIFACT=1
# DeepseekV4ForConditionalGeneration is in the engine's default breakable-
# cudagraph list; upstream pins 0 (unbroken graphs). Engine default is also 0.
VLLM_USE_BREAKABLE_CUDAGRAPH=0
# Count captured-graph memory in the profiler so the pool it reports is real.
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=1
# FlashInfer sampling kernels (upstream 1).
VLLM_USE_FLASHINFER_SAMPLER=1
# Lets MAX_MODEL_LEN exceed what the engine derives from the config's
# original_max_position_embeddings (65,536 before YaRN). Required above that.
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
# Engine default 1 (ragged MoE shapes without padding). The 2026-08-26 A8
# crash rule is moot: B12X_MOE_FORCE_A8 is not read on this branch. A/B 0.
VLLM_MOE_SKIP_PADDING=1
# NOT set on purpose: VLLM_PREFIX_CACHE_RETENTION_INTERVAL (the 0731 env's
# 4096) is deprecated in favour of the prefix_cache_retention_interval config
# field, and an EMPTY value crashes argparse with int('') -- --env-file
# passes empty strings, not unset variables. Engine default (0) applies.

# DeepGEMM JIT through nvcc, not NVRTC (upstream DSV4 recipes, sm_121).
DG_JIT_USE_NVRTC=0
USE_CUDNN=1

# NOT present on purpose -- nothing on this branch reads them (grep of vLLM
# a6571d0 + b12x 00b69ac). The launcher warns if they reappear:
#   VLLM_USE_B12X_MOE / _FP8_GEMM / _SPARSE_INDEXER / _MHC / _WO_PROJECTION /
#   _DCP_A2A, B12X_MOE_FORCE_A8 / _A16, B12X_W4A16_TC_DECODE,
#   B12X_MLA_SM120_UNIFIED, VLLM_MEMORY_PROFILE_INCLUDE_ATTN, VLLM_DSPARK_*


# =============================================================================
# 6. COLLECTIVES
# =============================================================================

# RoCEnante (decision D2, 2026-09-10): b12x one-shot RoCE for TP all-reduces
# <= ALLREDUCE_MAX_SIZE and all-gather shards <= ALLGATHER_MAX_SIZE; NCCL keeps
# the rest. upstream DSV4 TP2 values: 2 MiB / 16 MiB. hidden 4096 x BF16 =
# 8 KiB per token, so 2 MiB covers a 256-token decode/verify step; an 8192-
# token prefill chunk (64 MiB) stays on NCCL by design -- the launcher's
# "below 16 MiB" warning is expected here. Measured neutral on GLM at TP=2;
# unmeasured on DSV4. 0 = NCCL for everything.
VLLM_ENABLE_ROCE_ALLREDUCE=1
VLLM_ROCE_ALLREDUCE_MAX_SIZE=16777216
VLLM_ROCE_ALLGATHER_MAX_SIZE=16777216
B12X_ROCE_CACHE_DIR=/cache/jit/b12x-roce

# The B12X PCIe allreduce is a single-node path; the image bakes 1, this
# overrides to 0 and the launcher refuses 1.
VLLM_ENABLE_PCIE_ALLREDUCE=0


# =============================================================================
# 7. LOADER AND RUNTIME
# =============================================================================

# fastsafetensors: upstream since 6575b5a (2026-09-05). instanttensor: the
# 0731-era DSpark draft-load OOM no longer reproduces on current pins
# (user-verified on r37/r38 boots); the launcher warning is retired.
# b12x needs VLLM_PLUGINS=b12x_loader and a measured steady-state throughput
# before adoption (write-combined storage cost prefill on GB10 before 782daa1).
LOAD_FORMAT=instanttensor

# InstantTensor-ONLY bounds; inert under fastsafetensors and only passed to
# the container when instanttensor is selected.
INSTANTTENSOR_BUFFER_SIZE=1342177280
INSTANTTENSOR_IO_DEPTH=3
INSTANTTENSOR_CONCURRENCY=1
INSTANTTENSOR_CHUNK_SIZE=8388608
INSTANTTENSOR_BACKEND=BUFFERED
INSTANTTENSOR_COPY=auto
SAFETENSORS_FAST_GPU=1

# Fully offline: the model resolves from the mount only.
HF_HOME=/root/.cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
VLLM_NO_USAGE_STATS=1

# Empty = no plugins (set b12x_loader only with LOAD_FORMAT=b12x).
VLLM_PLUGINS=
# fork + CUDA is unsafe; spawn is required.
VLLM_WORKER_MULTIPROC_METHOD=spawn

# Compat shim FIRST (image kernels are CUDA 13.2; the host driver exports
# older), then the patched NCCL for the switchless pair. The launcher verifies
# both paths exist inside the image.
LD_PRELOAD=/usr/local/cuda/compat/libcuda.so.1:/opt/libnccl-local-inference.so.2.30.4
VLLM_NCCL_SO_PATH=/opt/libnccl-local-inference.so.2.30.4
NCCL_LOCAL_INFERENCE_PATH=/opt/libnccl-local-inference.so.2.30.4
NCCL_PR2127_PATH=/opt/libnccl-local-inference.so.2.30.4
TORCH_USE_RTLD_GLOBAL=1

# JIT toolchain: Triton and DeepGEMM use the image's CUDA 13.2 ptxas/nvcc.
CUDA_HOME=/usr/local/cuda
TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas

# Allocator: expandable segments, required alongside NCCL_CUMEM_ENABLE=0.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_DEVICE_MAX_CONNECTIONS=32

# Grace CPU threads for torch. The qualified r29/r35 shared-image DS4
# profiles run 2 ("Graph mode is FULL_AND_PIECEWISE; OMP uses two threads",
# rtx6kpro/models/ds4-jovian-community-r29.md). 16 was the upstream A/B
# candidate -- unmeasured on this pair; revisit after bring-up.
OMP_NUM_THREADS=2

# docker or podman.
CONTAINER_RUNTIME=docker
# Optional suffix so two env files can run side by side on one host (A/B).
CONTAINER_NAME_SUFFIX=


# =============================================================================
# 8. FABRIC -- RoCEv2 over the direct link; launcher-enforced
# =============================================================================

# single = ONE cable between the nodes. dual only with both CX7 ports cabled.
FABRIC_PROFILE=single

# RoCE presents IB semantics over Ethernet. The image bakes NCCL_IB_DISABLE=1
# for single-node boxes; without this override the pair falls back to TCP.
NCCL_NET=IB
NCCL_NET_PLUGIN=none
NCCL_IB_DISABLE=0
NCCL_TUNER_PLUGIN=none

# Single-path: 0/0 (validated on the GLM pair).
# Fabric profiles (measured 2026-09-21, Luke's launchers):
#   single-path (validated on this pair): MERGE_NICS=0, one HCA in
#     NCCL_IB_HCA, one cable.
#   dual-path (Luke's Spark launchers): MERGE_NICS=1 with BOTH Linux
#     interfaces of the cabled port in NCCL_IB_HCA (rocep1s0f0,roceP2p1s0f0)
#     -- the two PCIe Gen5 x4 paths into the SAME CX-7, not a second cable:
#     one 200G link striped over both PCIe paths (196 Gb/s combined vs the
#     single-path cap). The second interface needs its own IPv4 (own /24) so
#     the GID index is populated on both; RoCEnante picks up to two HCAs.
#     SUBNET_AWARE_ROUTING is no longer part of that profile (dropped
#     upstream at 9e5d179); it only matters behind a switch.
NCCL_IB_SUBNET_AWARE_ROUTING=0
NCCL_IB_MERGE_NICS=0

# Qualified protocol/topology set for the direct-cable pair.
NCCL_PROTO=LL,LL128,Simple
NCCL_P2P_LEVEL=SYS
NCCL_CROSS_NIC=1

# NCCL's CUDA VMM allocator conflicts with expandable_segments: keep 0.
NCCL_CUMEM_ENABLE=0

# Grace's unified layout defeats NCCL's NUMA guesses.
NCCL_IGNORE_CPU_AFFINITY=1

# WARN for serving; INFO names the transport per channel when debugging.
NCCL_DEBUG=WARN


# =============================================================================
# BRING-UP ORDER (record every number in the header when done)
#
# 1. --check both ranks. Confirm the command shows --attention-backend B12X,
#    a dense cudagraph_capture_sizes list, and the dspark speculative JSON
#    with enable_adaptive_verification true.
# 2. Profile boot: KV_CACHE_MEMORY_BYTES empty, vision ON, MM_IMAGES at the
#    launcher default (16). Take from the rank-0 log:
#      "Available KV cache memory" -> the byte pin
#      "GPU KV cache size: N tokens" -> must exceed MAX_MODEL_LEN
#      "Maximum concurrency for L tokens" -> real concurrency
#    and bytes/tokens -> per-token cost on THIS pin.
# 3. --verify on BOTH ranks: DeepseekV4ForConditionalGeneration (vision
#    wrapper, not the text class), fp8_ds_mla, the DSpark drafter lines, and
#    "Graph capturing finished". A server that answers /health can still be
#    on the FlashInfer fallback.
# 4. Pin the bytes. Raise MAX_MODEL_LEN toward 1048576 while the token count
#    covers it; keep MAX_NUM_SEQS x (depth+1) == MAX_CUDAGRAPH_CAPTURE_SIZE.
# 5. One knob per boot, in this order of expected payoff: depth 3/5/7 under
#    adaptive verification; MM_ENCODER_TP_MODE=data; RoCEnante off/on;
#    OMP_NUM_THREADS 16/2; VLLM_MOE_SKIP_PADDING 1/0.
# 6. Any change of speculator depth, vision mode, loader, or pin invalidates
#    2-4: re-measure. A benchmark JSON and an env file describing different
#    boots are never published together.
# =============================================================================
