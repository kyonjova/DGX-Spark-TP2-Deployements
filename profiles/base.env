# deployments/profiles/base.env — pair-wide identity consumed by env-create.sh.
# These keys are identical for every model, so they live outside model profiles.
# A value here (non-empty, non-<placeholder>) is offered as an editable default
# at each run; placeholders mean "always ask".
# NODE_RANK is derived from the rank question and is not prompted.

# rank 0 fabric IPv4 (CX7 link); also rank 0 VLLM_HOST_IP
MASTER_ADDR=

# rank 1 fabric IPv4 (rank 1 runs only)
VLLM_HOST_IP_RANK1=

# CX7 link interface (`ip -br link`)
NCCL_SOCKET_IFNAME=

# must match NCCL_SOCKET_IFNAME
GLOO_SOCKET_IFNAME=

# RDMA device (`ibv_devices`)
NCCL_IB_HCA=

# RoCEv2 IPv4 GID index (`show_gids`)
NCCL_IB_GID_INDEX=
