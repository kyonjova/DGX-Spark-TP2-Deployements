# =============================================================================
# glm-53-flash-csf_rank.env.example -- GLM-5.3-Flash-NVFP4-MXFP8-CSF-QAD,
# 2-node DGX Spark pair (TP=2), performance profile.
# Image: local/vllm:karmic-kraken-intcache1008-cu132, built from
#   dgx-spark-builder/build-kk-integration-cache-cu132.env (vLLM
#   integration/karmic-kraken-beta 19f2c20e on LIL FlashInfer 0.7.1 b4c35e6e
#   with B12X inside, CuTe DSL 4.7.1). CSF loads through ModelOpt recipes
#   (--quantization modelopt_mixed) with the native b12x loader (section 7).
# Checkpoint: local-inference-lab/GLM-5.3-Flash-NVFP4-MXFP8-CSF-QAD @ dec48abd
#   (HF main), Hugging Face layout: NVFP4 QAD routed experts with losslessly
#   compressed scales (they stay compressed in GPU memory), MXFP8 attention +
#   shared experts, NVFP4 MTP experts, vision tower stored quantized (MXFP8
#   attention, W4A16 NVFP4 MLP).
# Status (2026-10-09): the 2026-10-06 tuning (runs R1-R3) carried onto this
#   image and checkpoint; the 2026-10-09 bench is at parity with the previous
#   image (reference at the end). Evals not yet re-run: see BRING-UP.
#
# Provenance tags on values:
#   (release)  blackwell-llm-docker glm53-tp2 preset / glm53-flash profile
#              (RTX PRO 6000 TP2, NOT GB10)
#   (measured) this pair; the date says which run. Decode is compared on
#              engine steps/s (acceptance-normalized), noise +-3%.
#   (GB10)     Spark-specific deviation from the release, with the reason
#
# Copy once per node and resolve section 1 (the launcher refuses to run while
# any <placeholder> remains). Only section 1 differs between the two files.
#     cp glm-53-flash-csf_rank.env.example rank-0.env
#     cp glm-53-flash-csf_rank.env.example rank-1.env
#     ./glm-53-flash-csf_pair-serve.sh --check rank-0.env
#
# NOT here on purpose (the launcher derives them and refuses raw copies):
#   VLLM_B12X_MOE_FP4_FORCE_A16, B12X_W4A16_FP32_TOPK_WEIGHTS,
#   B12X_W4A16_A4_PREFILL, VLLM_B12X_NVFP4_ACTIVATION_MODE,
#   VLLM_B12X_MLA_CKV_GATHER -> see EXPERT_ACTIVATIONS / ROUTER_WEIGHTS /
#   PREFILL_ACTIVATIONS / DCP_SIZE. --quantization is modelopt_mixed;
#   --load-format is LOAD_FORMAT (section 7).
# =============================================================================


# =============================================================================
# 1. REQUIRED -- resolve every <placeholder>
# =============================================================================

# 0 = API node (serves HTTP, coordinates the pair); 1 = headless worker.
NODE_RANK=<0_or_1>

# Rank 0's IPv4 on the ConnectX-7 link. IDENTICAL in both files.
MASTER_ADDR=<rank0_fabric_ipv4>

# THIS node's IPv4 on the link (rank 0: = MASTER_ADDR).
VLLM_HOST_IP=<this_node_fabric_ipv4>

# The hf download ROOT (config.json, model.safetensors.index.json, tensors/),
# same revision on both nodes. --check validates the CSF recipes and that
# every indexed shard is present, and reads revision + per-shard LFS SHA-256
# from the download metadata (no shard is hashed). Download (~178 GB) with:
#   hf download local-inference-lab/GLM-5.3-Flash-NVFP4-MXFP8-CSF-QAD \
#     --revision dec48abd33efa73c3bb7c95b74eee10cad34f9be \
#     --local-dir <new_empty_dir>
# --local-dir keeps .cache/huggingface/download/ next to the files; copy it
# along (rsync -a) if node 2 is filled from node 1. One --local-dir per
# revision under one parent (revisions share no LFS object, so nothing
# dedups): downloading a second commit into the same folder overwrites the
# first.
MODEL_HOST_PATH=<abs_path_to_csf_download_root>

# Pin the checkpoint by content once both nodes hold it: run --check on each
# node, compare the printed "checkpoint identity", paste it here in BOTH
# files. Empty = not enforced (the identity is still printed). The value is
# blackwell-llm-docker's content digest; dec48abd downloaded with hf =
# bc453166d2d32020847a51d8aedab725bf96c9e6e25635181c8a0ca49530ec0e.
CHECKPOINT_IDENTITY_SHA256=

# Optional guard that MODEL_HOST_PATH is the folder of the intended Hub
# commit: 7-40 hex (prefix of the full sha), compared with the revision hf
# download --local-dir recorded (.cache/huggingface/download/). Empty = not
# checked. --check dies on a mismatch, on mixed revisions, or when the
# folder has no download metadata. E.g. dec48abd.
CHECKPOINT_REVISION=

# Writable JIT/compile cache, 4+ directory levels deep (a --clear safety
# rule). One directory per image: B12X/CuTe DSL, Triton and FlashInfer
# artifacts are compiler-version specific, and sharing a cache between
# images only mixes them. Must not contain MODEL_HOST_PATH.
CACHE_HOST_PATH=<abs_path_to_writable_cache>

# Same tag or digest on both nodes.
SERVING_IMAGE=local/vllm:karmic-kraken-intcache1008-cu132

# Fabric identity, read from THIS host:
#   ip -br link   -> the netdev on the CX7 link (NCCL and Gloo must match)
NCCL_SOCKET_IFNAME=<fabric_ifname>
GLOO_SOCKET_IFNAME=<fabric_ifname>
#   ibv_devices   -> with FABRIC_PROFILE=dualpath BOTH PCIe functions of the
#                    cabled cage, comma-separated (e.g. rocep1s0f0,roceP2p1s0f0)
NCCL_IB_HCA=<rdma_devices>
#   show_gids     -> the RoCEv2 IPv4 row's index; --check verifies it on every
#                    device in NCCL_IB_HCA.
NCCL_IB_GID_INDEX=<rocev2_ipv4_gid_index>


# =============================================================================
# 2. SERVING SHAPE
# =============================================================================

API_PORT=8000
MASTER_PORT=29500
# Empty = open port on the LAN; set to require "Authorization: Bearer <key>".
API_KEY=
# (release) name. Comma-separated aliases allowed; the first is reported.
SERVED_MODEL_NAME=GLM-5.3-Flash

# Speculator. mtp = the checkpoint's own MTP layer (NVFP4 experts -> b12x
# draft MoE). dflash2 = separate DFlash2 drafter (7 tokens; needs
# DFLASH_MODEL_HOST_PATH). none.
SPECULATOR=mtp
# (release, measured) MTP3: static 3 beat adaptive and depth 5 on this pair
# (acceptance 2.60). (measured 2026-10-09) acceptance 2.44-2.73 across
# C1-C8 x 0-64K, 2.63 draft-weighted.
NUM_SPECULATIVE_TOKENS=3
ADAPTIVE_SPECULATIVE_TOKENS=0
ADAPTIVE_SPECULATIVE_TOKENS_INITIAL=3
ADAPTIVE_SPECULATIVE_TOKENS_WINDOW=32
# (release) b12x: this checkpoint's MTP experts are NVFP4 (W4A16 group).
MTP_MOE_BACKEND=b12x
MTP_ATTENTION_BACKEND=B12X
# (release) probabilistic proposals + standard rejection.
DRAFT_SAMPLE_METHOD=probabilistic
REJECTION_SAMPLE_METHOD=standard
# GLM KDA speculative recovery. Empty = auto (ON for GLM + MTP/DFlash <= 7
# tokens + BF16 + V2 runner + align: commits the accepted recurrent state
# instead of retaining one per draft position). Needs no KV connector or a
# request-boundary one: with PREFIX_CACHE != none the launcher passes
# --no-use-replayssm itself (~188 MiB/rank, upstream ~3% C1) and refuses 1.
# 0 = --no-use-replayssm (A/B), 1 = force.
REPLAYSSM=

# DFlash2 only (SPECULATOR=dflash2). Snapshot dir on BOTH nodes of
# local-inference-lab/GLM-5.3-Flash-DFlash2 (the release's drafter). The
# launcher adds draft_load_config {"load_format":"auto"}: the drafter is plain
# safetensors and must not inherit the target's LOAD_FORMAT.
DFLASH_MODEL_HOST_PATH=
DFLASH_WEIGHTS_SHA256=
DFLASH_KV_CACHE_DTYPE=auto
# (release) FLASH_ATTN for the drafter.
DFLASH_ATTENTION_BACKEND=FLASH_ATTN

# Context ceiling: the model maximum. Must fit one request in the KV pool
# (1M tokens is ~half the pool pinned below). -1 = auto-fit to the pin.
MAX_MODEL_LEN=1048576

# (release) 8 slots. One decode step = MAX_NUM_SEQS x (depth+1) = 32 rows.
MAX_NUM_SEQS=8

# (measured 2026-10-06) 8192-token prefill chunk, not the release's 4096:
# prefill 8K +22%, 32K-128K +5-7%, decode unchanged. Costs ~2.7 GiB of
# transient activations on rank 0 -- re-pin KV_CACHE_MEMORY_BYTES if this
# changes.
MAX_NUM_BATCHED_TOKENS=8192

# CUDA graphs. auto = MAX_NUM_SEQS x (depth+1) = 32 and the list
# 1,2,4,8,...,32 (every multiple of depth+1: exactly the shapes speculative
# decode produces; the release TP2 list). The engine's grid would capture up
# to 96: more graphs, more static memory, no extra shapes at 8 x MTP3.
MAX_CUDAGRAPH_CAPTURE_SIZE=auto
CUDAGRAPH_CAPTURE_SIZES=auto
CUDAGRAPH_MODE=FULL_AND_PIECEWISE
VLLM_USE_BREAKABLE_CUDAGRAPH=1

# (release) prefill compute sharing: prefill gets at most 40% of each step
# while decodes run, one prefill at a time; interval must be 1 with a share.
# (measured 2026-10-06, llm_checks.py mixed) C4 decode during an uncached
# 64K prefill: 56% of idle tok/s, longest stream freeze 4.8 s, the 64K
# prompt's TTFT 76 s. A/B: interval 8 with share empty (faster TTFT, longer
# freezes) -- scheduled in the Cache Test Suite.
PREFILL_SCHEDULE_INTERVAL=1
PREFILL_COMPUTE_SHARE=0.4
PREFILL_COMPUTE_HALF_LIFE=
MAX_PARALLEL_PREFILLS=1
FAIRNESS_ENGINE=

# (release) GPU prefix cache with request-boundary recurrent checkpoints:
# end of system/developer instructions, the full prompt, the committed
# response. Fewer retained KDA states than aligned -> more KV capacity for
# the same pin. aligned = checkpoints every recurrent page, for workloads
# that diverge inside long user messages; REQUIRED by both PREFIX_CACHE
# backends (section 9: lmcache refuses anything else, sparkcache warns).
# (measured 2026-10-06, llm_checks.py multiturn) 32K turn 1 + answer, then
# turn 2: 32,588 of 32,589 tokens served from cache, TTFT 14.5 s -> 0.49 s.
RECURRENT_CHECKPOINT_POLICY=request_boundaries

BLOCK_SIZE=256

# Decode context parallelism. 1 = each rank holds every request's MLA KV
# (cheapest decode: no cross-node attention gather). 2 = KV split across the
# two ranks: ~2x tokens for the same pin, plus a gather over RoCE in each
# MLA layer of every decode step (the release TP2 preset runs 2 on PCIe;
# Luke's GB10 TP2 launcher and our measured profiles run 1). Throughput A/B
# for long-context / high-concurrency loads only.
DCP_SIZE=1


# =============================================================================
# 3. EXPERT PRECISION (launcher maps these to the b12x/vLLM variables)
# =============================================================================

# (release, checkpoint card) W4A16 experts: FP4 weights, BF16 activations
# (VLLM_B12X_MOE_FP4_FORCE_A16=1). fp4 = W4A4 (faster decode, off the card's
# accuracy settings; quality A/B only). GB10 decode is weight-bandwidth bound
# and W4A4 reads the same FP4 weights, so it saves compute only.
EXPERT_ACTIVATIONS=bf16
# (release, checkpoint card) FP32 router weights for the W4A16 combine
# (B12X_W4A16_FP32_TOPK_WEIGHTS=1).
ROUTER_WEIGHTS=fp32
# (release) a4 (B12X_W4A16_A4_PREFILL=1, set by the launcher): EVERY prefill
# row of the W4A16 MoE calls runs with NVFP4 activations over the same packed
# weights -- short prompts, chunk tails and multi-turn deltas included;
# decode, verification, graph replay and draft rows stay A16. Needs the
# checkpoint's calibrated expert input scales (dec48abd: 36,288; --check
# counts them -- without them B12X runs A16 silently). LIL: as accurate as
# a16 (estonia, hotel-lights, lavd-test, tool-eval, needle-checksum) and
# +27% prefill at 8K/32K on 2x RTX TP2.
# a16 = BF16 activations everywhere.
PREFILL_ACTIVATIONS=a4


# =============================================================================
# 4. MEMORY
# =============================================================================

# KV + recurrent pool per rank, bytes, pinned (profiling skipped). Sized by
# rank 0, which also hosts the API server + EngineCore (~2 GiB more than the
# headless rank 1). 19377663936 = 18.05 GiB: 2,580,121 KV tokens, 2.46x a
# 1M-token request. (measured 2026-10-09) rank 0 keeps ~2 GiB MemAvailable
# through the full bench -- below the 3 GiB target the 2026-10-06 tuning
# used, accepted for this profile; do not go lower. A first boot after a new image or --clear runs far lower
# (0.79 GiB, 6.4 GiB pushed to swap: B12X compile workers + JIT) -- see
# BRING-UP step 2.
KV_CACHE_MEMORY_BYTES=19377663936

# Startup gate only (the pin sizes the pool): vLLM refuses when
# MemAvailable < MemTotal x this. GB10 counts reclaimable page cache as
# available (integrated-GPU path), so 0.85 passes on an idle node.
GPU_MEMORY_UTILIZATION=0.85

# (release) fp8 KV (engine selects the B12X fp8_ds_mla layout).
KV_CACHE_DTYPE=fp8

# --check memory preflight: die | warn | off.
MEM_PREFLIGHT=die

# cgroup cap so a runaway load kills the container, not the node. Empty =
# unlimited. Luke's GB10 launcher uses 108.
CONTAINER_MEMORY_GB=


# =============================================================================
# 5. MULTIMODAL
# =============================================================================

# 0 = serve images (vision-language checkpoint); 1 = text only (skips the
# encoder cache and vision profiling: more KV). The tower runs on the
# checkpoint's stored recipes (MXFP8 attention, W4A16 NVFP4 MLP).
LANGUAGE_MODEL_ONLY=0
LIMIT_MM=1
MM_IMAGES=32
MM_VIDEOS=0
# Host-RAM media cache = the same pool as KV on GB10; 0 disables.
MM_PROCESSOR_CACHE_GB=0
# Each rank encodes its own images: no encoder collectives over RoCE.
MM_ENCODER_TP_MODE=data


# =============================================================================
# 6. KERNELS, COLLECTIVES, RUNTIME POLICY
# =============================================================================

# GB10 is sm_121 (the launcher refuses anything else).
CUTE_DSL_ARCH=sm_121a
FLASHINFER_CUDA_ARCH_LIST=12.1f

# Backends. MoE must be b12x (the CSF recipes hand b12x the compressed
# experts); B12X attention; b12x linear (MXFP8 projections).
MOE_BACKEND=b12x
ATTENTION_BACKEND=B12X
LINEAR_BACKEND=b12x
ENABLE_FLASHINFER_AUTOTUNE=0
# (release) b12x KDA prefill; decode backend/kernel = engine default (auto).
KDA_PREFILL_BACKEND=b12x
KDA_DECODE_BACKEND=
GDN_DECODE_KERNEL=
# Per-expert activation scales (engine default). Never leave empty-valued.
VLLM_B12X_MOE_FP4_LAYER_MAX_INPUT_SCALE=0
# (release default) the next layer's compressed scales expand during the
# current layer's attention: +1-3% prefill on CSF W4A16 layers.
VLLM_B12X_CSF_SCALE_PREFETCH=1

# B12X preparation: measured kernel selection at startup, cached under /cache.
B12X_AUTOTUNE=1
B12X_COMPILE_CACHE_DIR=/cache/jit/b12x/compile
# (GB10) 4 = b12x's GB10 default; host-side CuTe DSL compiles share the
# unified pool with the model. A cold cache compiles ~2,500 kernels (first
# boot ~11 min); copy the finished cache node 1 -> node 2 (tuning keys by
# device name).
B12X_COMPILE_WORKERS=4

# Vocabulary heads on GB10. Which weight makes the MTP draft logits:
#   MXFP8_LM_HEAD  MTP_NVFP4_LM_HEAD  MTP_DRAFT_HEAD  verifier  draft
#   1              1                  bf16            MXFP8     own NVFP4 (path A, this profile)
#   0              0                  nvfp4           BF16      NVFP4 copy of target (path B, release)
#   1              0                  bf16            MXFP8     shares MXFP8 target head
#   any other with MTP_DRAFT_HEAD=nvfp4: vLLM silently skips the copy (the
#   head it gets is already quantized) -> the launcher refuses it.
#   VLLM_GLM53_MTP_DRAFT_HEAD=nvfp4: FlashInfer CuTe-DSL W4A16 copy of the
#     BF16 target head (~170 MiB/rank); accepted on GB10 (12.1) since vLLM
#     #995. Not yet run here (test plan section 4); path B gives up the
#     MXFP8 verifier head below.
#   VLLM_MTP_NVFP4_LM_HEAD=1: the MTP layer gets its own runtime-quantized
#     NVFP4 head (no capability gate; Luke's GB10 launcher runs 1).
#   VLLM_MXFP8_LM_HEAD=1 (release 0 = BF16 verifier): quantizes the target
#     head to MXFP8 at load. (measured 2026-10-06) steps/s +2-4% at C1, up
#     to +7.6% at C8, coding peak +4%, acceptance unchanged, -0.27 GiB/rank;
#     llm_checks.py json-copy 9/9 exact at 8K/32K/64K.
VLLM_GLM53_MTP_DRAFT_HEAD=bf16
VLLM_MTP_NVFP4_LM_HEAD=1
VLLM_MXFP8_LM_HEAD=1
VLLM_LM_HEAD_A16=1
VLLM_GDN_SPEC_DECODE_METADATA_FASTPATH=1
VLLM_SSM_CONV_STATE_LAYOUT=DS

# (release) GLM model-profile policy, verbatim (PCIe-only keys omitted).
B12X_DYNAMIC_SPLIT_ROUTE_COMPUTE=1
B12X_DYNAMIC_DIRECT_EXPERT_SCALES=1
B12X_DYNAMIC_SPLIT_LOW_SMEM=1
B12X_DYNAMIC_SKIP_SPLIT_BARRIER_RESET=1
B12X_DYNAMIC_SPLIT_FAST_PREPARE=1
B12X_DYNAMIC_WORK_SOURCE=persistent_grid
B12X_DYNAMIC_SPLIT_COMPUTE_MAC=224
B12X_MHC_PDL=1
VLLM_GLM53_DFLASH_ATTN=1
VLLM_CAUSAL_CONV1D_UPDATE_HOIST=1
VLLM_GLM53_KDA_GATE_SIDE_STREAM=1
VLLM_DISABLE_SHARED_EXPERTS_STREAM=0
VLLM_DISABLED_KERNELS=MarlinFP8ScaledMMLinearKernel
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_V2_MODEL_RUNNER=1
# FP8 weight-only decode for the BF16 attention/KDA/FFN/LM-head projections
# (vLLM 19f2c20e; replaces VLLM_GLM53_ONLINE_DENSE_MXFP8, which this vLLM no
# longer reads). Its shape tables are TP3-only, so it is a no-op at TP2 and
# stays off, as in the release.
VLLM_GLM53_FP8_DENSE=0
# (release) one NCCL communicator for TP/DCP/EP groups over the same GPUs
# (74 MiB/rank at TP2+DCP2; small at DCP1).
VLLM_SHARE_PYNCCL_COMMS=1
# (GB10) 0, not the release's 1: pinned host RAM IS GPU memory on GB10, so
# moving the embedding table there frees nothing and costs 1-3% prefill.
VLLM_GLM53_EMBED_HOST=0

# L2 weight prefetch: the engine enables it by default on SM120 only (GB10 is
# 12.1, so off). The GLM windows (20/50/15 MB, 36 MB on MLA layers) are sized
# for the RTX PRO 6000's 128 MB L2; GB10 reports 25 MB. (measured 2026-10-06)
# 0, explicit: with the GB10 windows below it changed no cell beyond +-3%
# steps/s (mean +0.1%; it only prefetches batches <= 256 tokens, so prefill
# is untouched) for +0.08 GiB of graph memory. The tested windows, if it is
# ever re-tried:
VLLM_GLM53_L2_PREFETCH=0
#VLLM_GLM53_L2_PREFETCH_BUDGET_A_MB=20
#VLLM_GLM53_L2_PREFETCH_BUDGET_B_MB=16
#VLLM_GLM53_L2_PREFETCH_BUDGET_C_MB=15
#VLLM_GLM53_L2_PREFETCH_BUDGET_A_MLA_MB=16
# Persisting-L2 set-aside per rank (boot log: "L2 25 MB, max 19 MB"). 0: a
# set-aside would shrink the L2 every other kernel streams through.
VLLM_GLM53_L2_PREFETCH_PERSIST_MB=0

# (release) split cache pages: 2048-token attention pages; recurrent page
# follows (auto = the target page under request_boundaries).
VLLM_GLM53_SPLIT_TARGET_BLOCK_SIZE=2048
VLLM_GLM53_SPLIT_MAMBA_BLOCK_SIZE=auto

# torch.compile level: empty = none (CUDA graphs only; B12X kernels are
# opaque to Inductor). AOT artifacts are a boot-time lever only:
#VLLM_USE_AOT_COMPILE=1
COMPILATION_LEVEL=

# (release) sampling defaults, explicit: the launcher builds
# --override-generation-config from them. Per-request fields still win.
# T=1 / top-p 0.95 is the publisher's contract the MTP acceptance was
# measured under.
GENERATION_CONFIG=auto
SAMPLING_TEMPERATURE=1.0
SAMPLING_TOP_P=0.95
SAMPLING_TOP_K=
SAMPLING_MIN_P=
SAMPLING_REPETITION_PENALTY=
REASONING_EFFORT=high
CLEAR_THINKING=0

# (release) LIL's runtime template (runtime/templates/glm53-flash.jinja,
# sha256 b5bbea09...): the official template with assistant content rendered
# exactly as generated. The checkpoint's own chat_template.jinja (dec48abd)
# renders content.strip(), so a returned answer re-renders to different
# tokens and the next turn reuses only the turn-1 prompt, not the response
# checkpoint (the reply is prefilled again). Relative = next to the
# launcher. Empty = the checkpoint's own template.
CHAT_TEMPLATE_HOST_PATH=glm-53-flash-csf_chat-template.jinja

# Host dir for torch profiler traces; empty = profiling off.
TORCH_PROFILE_HOST_DIR=

# Rust tokenizer backend (fastokens 0.3.2, in the image; the release enables
# it by default). (measured 2026-10-06) equivalence gate PASSED for this
# tokenizer (corpus + chat template); 510,144 tokens in 58 ms vs 1208 ms
# standard (21x); client-side overhead at 64K 0.38 -> 0.13 s. Re-run the gate
# after any image or checkpoint change:
#   VERIFY_TOKENIZER_DIRS=<MODEL_HOST_PATH> \
#     ./verify-image-cu132.sh <SERVING_IMAGE> build-kk-integration-cache-cu132.env
VLLM_USE_FASTOKENS=1

# --- RoCEnante (b12x one-shot RoCE collectives) ---
# (measured) 16 MiB: prefill 8k +19% vs the 2 MB default, decode unchanged.
# GLM-5.3's hidden size is 4096, so one all-reduce of an N-token step is
# N x 8 KiB, twice per layer. 16 MiB covers steps of up to 2048 tokens:
# every decode step (32 rows = 256 KiB) and short or tail prefill chunks; a
# full 8192-token step (64 MiB) goes to NCCL. (measured 2026-10-06) routing
# the full step to RoCEnante (67108864): prefill -3 to -7% and ~0.5 GiB more
# pinned per rank, so 16 MiB stays. The all-gather only carries vocab-split
# logits rows (<= ~5 MiB at 32 rows x 77,440 x BF16): 16 MiB is never hit.
VLLM_ENABLE_ROCE_ALLREDUCE=1
VLLM_ROCE_ALLREDUCE_MAX_SIZE=16777216
VLLM_ROCE_ALLGATHER_MAX_SIZE=16777216
B12X_ROCE_CACHE_DIR=/cache/jit/b12x-roce
# Empty = follow NCCL_IB_HCA (b12x stripes over up to two devices).
B12X_ROCE_HCA=
# Single-node PCIe path; must be 0 on a pair.
VLLM_ENABLE_PCIE_ALLREDUCE=0

# --- runtime ---
# cu132 image (CUDA 13.2, NCCL 2.30.4): compat shim first (13.2 needs
# cuTensorMapEncodeTiled, missing from the 580 driver), then patched NCCL.
LD_PRELOAD=/usr/local/cuda/compat/libcuda.so.1:/opt/libnccl-local-inference.so.2.30.4
VLLM_NCCL_SO_PATH=/opt/libnccl-local-inference.so.2.30.4
NCCL_LOCAL_INFERENCE_PATH=/opt/libnccl-local-inference.so.2.30.4
NCCL_PR2127_PATH=/opt/libnccl-local-inference.so.2.30.4
TORCH_USE_RTLD_GLOBAL=1
CUDA_HOME=/usr/local/cuda
TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas
# expandable segments (required with NCCL_CUMEM_ENABLE=0; also what the
# weight-load stranding fix keys on: ~0.5 GiB more free per rank).
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_DEVICE_MAX_CONNECTIONS=32
# (release, measured 2026-10-06) 1 torch CPU thread per process; no decode
# change vs 2.
OMP_NUM_THREADS=1
CONTAINER_RUNTIME=docker


# =============================================================================
# 7. LOADER
# =============================================================================

# Weight loader; --load-format = this.
#   b12x           vLLM's native B12xModelLoader (19f2c20e, d0f0cad9; the
#                  reader is FlashInfer's b12x.loader). O_DIRECT reads through
#                  an io_uring ring straight into ordinary CUDA allocations;
#                  read_mode auto = bounce on GB10. CSF experts arrive as
#                  meta tensors and load straight into the packed buffers
#                  (9cbd0066, #1016). (measured 2026-10-09) model load 171.6 s
#                  (weights 78.8 s) vs 267-276 s with the previous dedicated
#                  CSF loader; steady-state speed unchanged. Needs: liburing in
#                  the image (PATCH_IO_URING=on in the profile), io_uring
#                  allowed by the container seccomp (below), host sysctl
#                  kernel.io_uring_disabled=0; --check verifies all three.
#   instanttensor  the alternative; LIL's default for recipe CSF (RTX TP2
#                  load 214 -> 144 s). Set it here and uncomment the staging
#                  bounds below.
#   fastsafetensors | safetensors | auto: vLLM's stock readers.
LOAD_FORMAT=b12x

# Container seccomp for the b12x loader's io_uring ring. Leave this line
# commented: with LOAD_FORMAT=b12x the launcher passes the SHARED profile at
# the deployments root (../seccomp-io-uring.json, one copy for every model =
# vllm scripts/seccomp/spark-io-uring.json) via --security-opt; other loaders
# pass nothing. Override: a path (absolute or relative to the launcher's
# folder), none (docker daemon default already allows io_uring), or
# unconfined (last resort). --check probes io_uring inside the image with the
# resolved profile and dies with the fix if it is blocked.
#SECCOMP_PROFILE=../seccomp-io-uring.json

# InstantTensor-ONLY staging bounds (read by the instanttensor library; inert
# under b12x/fastsafetensors/auto -- the launcher passes them only when
# LOAD_FORMAT=instanttensor, and these values are its defaults).
# BUFFER_SIZE 1.25 GiB covers the largest tensor (the 1,268,776,960 B BF16
# vocab head); 64 MiB got auto-enlarged every boot.
#INSTANTTENSOR_BUFFER_SIZE=1342177280
#INSTANTTENSOR_IO_DEPTH=3
#INSTANTTENSOR_CONCURRENCY=1
#INSTANTTENSOR_CHUNK_SIZE=8388608
# auto only: vLLM >= 6575b5ac removed the instanttensor_copy option, and
# --check refuses 0/1.
#INSTANTTENSOR_COPY=auto

# Fully offline: the model resolves from the mount only.
HF_HOME=/root/.cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
VLLM_NO_USAGE_STATS=1
# Empty: the b12x loader and the CSF reader are built into this vLLM, and
# FlashInfer's b12x registers no plugin entry point (--check warns if
# b12x_loader is set).
VLLM_PLUGINS=
VLLM_WORKER_MULTIPROC_METHOD=spawn


# =============================================================================
# 8. FABRIC -- RoCEv2 over the direct ConnectX-7 link (launcher-enforced)
# =============================================================================

# (measured) dualpath: one cable, BOTH PCIe Gen5 x4 functions of the cabled
# cage (each netdev with its own IPv4 in its own /24; ~190 Gb/s vs one
# function's cap). NCCL uses both devices, RoCEnante stripes across both.
# Gain is in prefill (bandwidth-bound collectives); decode is latency-bound.
# single = one device; dual = second cable.
FABRIC_PROFILE=dualpath

NCCL_NET=IB
NCCL_NET_PLUGIN=none
NCCL_TUNER_PLUGIN=none
NCCL_IB_DISABLE=0
# dualpath and single: 0/0 (el8: MERGE_NICS=0 required for separate QP setup).
NCCL_IB_SUBNET_AWARE_ROUTING=0
NCCL_IB_MERGE_NICS=0
NCCL_PROTO=LL,LL128,Simple
NCCL_P2P_LEVEL=SYS
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN


# =============================================================================
# 9. EXTERNAL PREFIX CACHE -- persistent, per-node NVMe (one block; the
#    launcher builds --kv-transfer-config from it). Identical in both files.
#    Status: NOT yet run on this image (Cache Test Suite).
# =============================================================================
#
# What it adds over vLLM's GPU prefix cache: prefixes survive eviction from
# the KV pool AND container restarts, because each node also keeps them on
# its own NVMe. Nothing crosses the CX7 link except LMCache's small lookup
# messages. On GB10 "host RAM" is the same pool as the KV cache, so both
# backends are sized to hold as little RAM as possible -- the value is the
# disk tier, not a RAM tier.
#
#   none       -> GPU prefix cache only (this profile).
#   sparkcache -> FujitsuPolycom/sparkcache connector (in-process, no extra
#                 container). The image must carry the SparkCache vLLM patches
#                 (this one does: vmm-exemption + shared-prefix-lease for
#                 19f2c20e, never run); --check reads the image label.
#                 Rank-local: each node stores its own copy of the MLA KV and
#                 its half of the KDA state; the scheduler restores only a
#                 prefix both nodes hold, and only for a request with no GPU
#                 prefix hit. RAM: a snapshot is staged in host memory while
#                 written or read, <= ~7.5 KB/token, so MAX_SPAN 262144 tokens
#                 is <= ~1.8 GiB per node per lane.
#   lmcache    -> LMCacheMPConnector, aligned chunks, one `lmcache server`
#                 per node (the launcher starts it as a second, CPU-only
#                 container, glm53-flash-r<N>-lmcache, before vLLM; --down
#                 removes both). RAM: L1 is pinned /dev/shm allocated up front
#                 (engine-driven mode), so L1_GB is exactly what it costs per
#                 node. LIL's runtime rejects GLM TP2 + aligned without a
#                 stated reason: whether the engine accepts it is part of the
#                 test.
#
# Turning either on also changes, automatically or by --check:
#   * RECURRENT_CHECKPOINT_POLICY must be aligned (section 2); re-read "GPU
#     KV cache size" after switching -- aligned retains more KDA states.
#   * REPLAYSSM: the launcher passes --no-use-replayssm and refuses 1.
#   * KV_CACHE_MEMORY_BYTES: subtract the backend's RAM (+0.2 GiB for
#     REPLAYSSM=0) from the pin -- rank 0 has only ~2 GiB headroom at the
#     profile pin; --check warns and prints the ceiling.
PREFIX_CACHE=none

# Host directory on THIS node's NVMe (absolute; mounted at /prefix-cache).
# Required unless PREFIX_CACHE=none; must not sit inside CACHE_HOST_PATH
# (--clear) or MODEL_HOST_PATH. Each backend writes under a subdirectory
# named by cache identity + serving layout (TP, DCP, page sizes, KV dtype,
# policy, speculator, chunk), so an incompatible change starts a fresh
# namespace instead of reading stale pages.
PREFIX_CACHE_HOST_PATH=

# Disk budget per node, GiB. Eviction starts at 90% (sparkcache low
# watermark) / 80% (lmcache fs_native trigger).
PREFIX_CACHE_DISK_GB=200

# Cache identity of the target checkpoint (64 lowercase hex) or auto. auto =
# the checkpoint identity --check prints: identical on both nodes exactly
# when the downloads are. A stored prefix is never reused across identities.
PREFIX_CACHE_MODEL_IDENTITY=auto

# --- sparkcache only ---
# Prefix lengths worth snapshotting, tokens, multiples of 256. MIN skips
# short prompts (cheap to recompute); MAX bounds the host-RAM transient.
PREFIX_CACHE_SPARK_MIN_SPAN_TOKENS=4096
PREFIX_CACHE_SPARK_MAX_SPAN_TOKENS=262144
# read-write (default) | restore-only (serve stored prefixes, publish none)
# | store-only | disabled. Not part of cache identity.
PREFIX_CACHE_SPARK_ACCESS_MODE=read-write
# Parallel restore lanes (1-8). Each lane stages a snapshot in RAM; 1 keeps
# the transient at one snapshot.
PREFIX_CACHE_SPARK_LOAD_THREADS=1
# Seconds a restored prefix stays attachable on the GPU for followers (1-300;
# empty = connector default 15). Uses the shared-prefix-lease patch.
PREFIX_CACHE_SPARK_SHARED_PREFIX_TTL=

# --- lmcache only ---
# L1 pinned staging RAM per node, GiB (whole number). 2 = the floor we run;
# raise to 4 if restores or stores stall under concurrency.
PREFIX_CACHE_LMC_L1_GB=2
# RPC port of the lmcache server on BOTH nodes (HTTP health = +1, metrics =
# +2). Empty = API_PORT + 10000, as LIL's runtime does.
PREFIX_CACHE_LMC_PORT=
# Rank 1's IPv4 on the CX7 link, IDENTICAL in both files: rank 0's scheduler
# queries both nodes' servers (lookups only; KV stays on each node).
PREFIX_CACHE_LMC_RANK1_ADDR=
# fs_native L2 I/O and CPU worker threads per server (LIL defaults).
PREFIX_CACHE_LMC_L2_WORKERS=4
PREFIX_CACHE_LMC_CPU_WORKERS=4

# Test harness only (rank 0): 1 exposes vLLM's dev endpoints, including
# POST /reset_prefix_cache, which sparkcache-test.py uses to drop the GPU
# cache between phases. Never 1 on a LAN-facing server: the endpoints are
# unauthenticated.
VLLM_SERVER_DEV_MODE=0


# =============================================================================
# BRING-UP (fresh nodes, a new image, or after --clear)
#
# 1. Both nodes: sysctl kernel.io_uring_disabled must print 0, and
#    ../seccomp-io-uring.json must sit at the deployments root. Then
#    ./glm-53-flash-csf_pair-serve.sh --check rank-N.env; compare
#    "checkpoint identity" between nodes and paste it into
#    CHECKPOINT_IDENTITY_SHA256 in both files (dec48abd: bc453166...).
# 2. Compile boot: --fresh rank 1, then --fresh rank 0. A cold cache compiles
#    ~2,500 B12X kernels plus Triton/FlashInfer JIT (~11 min). Do NOT
#    benchmark this boot: (measured 2026-10-09) it ran prefill -8 to -20%
#    and rank 0 down to 0.79 GiB MemAvailable with 6.4 GiB in swap. Copy
#    <cache>/jit node 1 -> node 2 once it is warm.
# 3. Serving boot: --down both, then --fresh rank 1, then --fresh rank 0
#    (cache hits only). --verify on both: the "NVFP4-CSF
#    layer", "b12x weights loaded", RoCEnante and "split GLM-5.3 cache
#    pages" lines must be there.
# 4. Measure on the serving boot only: memwatch.sh on rank 0 through the full
#    bench; rank 0 must keep its ~2 GiB MemAvailable floor (section 4).
#    Re-pin KV_CACHE_MEMORY_BYTES after any change to speculator, vision,
#    DCP, MAX_NUM_SEQS or MAX_NUM_BATCHED_TOKENS.

# Reference (2026-10-09, serving boot, llm_decode_bench.py
# --standalone-prefill, C1-C8 x 0-64K, prefill 8K-128K):
#   engine steps/s, ctx 0 / 8K / 32K / 64K:
#     C1 15.7 / 15.8 / 15.7 / 15.7     C2 23.2 / 23.0 / 22.7 / 22.6
#     C4 32.0 / 31.2 / 31.9 / 30.9     C8 44.9 / 43.3 / 43.0 / 43.9
#   prefill tok/s: 8K 2200, 32K 2248, 64K 2289, 128K 2253
#   MTP acceptance 2.63 (draft-weighted); model load 171.6 s, 84.22 GiB;
#   2,580,121 KV tokens. Previous image (2026-10-06): steps/s -0.4% mean,
#   prefill -1 to -2% against this run.
# =============================================================================
