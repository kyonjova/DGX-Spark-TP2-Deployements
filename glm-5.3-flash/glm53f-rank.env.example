# =============================================================================
# glm53-rank.env.example -- GLM-5.3-Flash-NVFP4, 2-node DGX Spark pair (TP=2)
#
# EVERY setting is explicit here. Each line says what it does, what values
# are accepted, and (where it matters) which image it needs. Empty values
# are deliberate: "empty = the launcher omits the flag and the engine uses
# its own default". The launcher validates every value at --check time.
#
# Image this file is written for: R33/R34 (voipmonitor integration branches;
# 0906-class prefill with the split MoE prefill off, r30 fixes, r34 backend
# default). Values marked (measured) come from this pair's benchmarks. Lines that older images reject are marked [head-0903+] or
# [head-0905+]; the R12 image ignores unknown VLLM_* envs with a warning
# but rejects unknown serve flags.
#
# Copy once per node and resolve section 1 -- the launcher refuses to run
# while any <placeholder> remains:
#     cp glm53-rank.env.example rank-0.env   # API node
#     cp glm53-rank.env.example rank-1.env   # headless worker
# Only section 1 differs between the two files. Everything else MUST match.
# Validate: ./glm53_pair_serve.sh --check rank-0.env
# =============================================================================


# =============================================================================
# 1. REQUIRED -- resolve every <placeholder>. Nothing else needs editing to
#    serve the tested configuration.
# =============================================================================

# 0 = API node (serves HTTP, coordinates the pair); 1 = headless worker.
NODE_RANK=<0_or_1>

# Rank 0's IPv4 on the ConnectX-7 link. IDENTICAL in both files. The
# launcher dies if this address routes through a gateway (a one-digit typo
# otherwise hangs both ranks forever).
MASTER_ADDR=<rank0_fabric_ipv4>

# THIS node's IPv4 on the link. Rank 0: equal to MASTER_ADDR. Rank 1: the
# other Spark. Must be a local address (catches the wrong rank file).
VLLM_HOST_IP=<this_node_fabric_ipv4>

# Target snapshot directory holding config.json. Byte-identical on both
# nodes. Original NVFP4 (BF16 attention, 93.3 GiB/rank) is the qualified
# quality checkpoint; the -Spark variant (MXFP8 attention, 88 GiB/rank) is
# faster and lighter but failed the Estonia long-context test.
MODEL_HOST_PATH=<abs_path_to_model_snapshot>

# Writable JIT/compile cache, at least four directory levels deep (a safety
# rule for --clear, which wipes it). Holds torch.compile, Triton, FlashInfer,
# B12X artifacts and the RoCEnante proxy. Do NOT set XDG_CACHE_HOME /
# TRITON_CACHE_DIR / VLLM_CACHE_ROOT here; the image fingerprints them.
CACHE_HOST_PATH=<abs_path_to_writable_cache>

# The image built by build-spark-cu132.sh. Same tag or digest on both nodes
# (docker save | docker load keeps image IDs identical).
SERVING_IMAGE=<image_tag_or_digest>

# Fabric identity, read from THIS host, never copied from another machine:
#   ip -br link   -> the interface on the CX7 link (NCCL and Gloo must match)
NCCL_SOCKET_IFNAME=<fabric_ifname>
GLOO_SOCKET_IFNAME=<fabric_ifname>
#   ibv_devices   -> the RDMA device; exactly one for the single-rail profile
NCCL_IB_HCA=<rdma_device>
#   show_gids     -> the RoCEv2 IPv4 row's index. The #1 cause of silent
#   NCCL hangs when copied from elsewhere.
NCCL_IB_GID_INDEX=<rocev2_ipv4_gid_index>


# =============================================================================
# 2. SERVING SHAPE
# =============================================================================

# HTTP port on rank 0 / torch.distributed rendezvous port. Must differ.
API_PORT=8000
MASTER_PORT=29500

# API key: empty = open port on the LAN; set to require
# "Authorization: Bearer <key>" on every request (rank 0 passes --api-key).
# No whitespace. The --check summary prints only whether it is set.
API_KEY=

# Names clients may send, comma-separated, no spaces (the file is sourced).
# The first is what /v1/models reports.
SERVED_MODEL_NAME=GLM-5.3-Flash-NVFP4

# Speculator: mtp (built-in head, no extra weights; the general-purpose
# choice), dflash2 (separate draft; +35% coding peak, -7% prose, half the
# KV pool until the packed-cache allocator ships), none.
SPECULATOR=mtp

# Draft depth. mtp: 3 is the qualified depth and (measured) the best static
# depth here; 5 adaptive settled at 2.1-2.4 accepted. dflash2: 7 = its block.
NUM_SPECULATIVE_TOKENS=3

# Adaptive MTP depth (mtp only): 1 lets the engine adjust depth between 1
# and NUM_SPECULATIVE_TOKENS from measured acceptance; 0 = fixed depth.
# (measured) static 3 beat adaptive at c1-c4: acceptance 2.41 -> 2.60,
# 28.7 -> 30.8 tok/s single-stream, 68 -> 75 tok/s at 32k/c4; adaptive only
# looked better at c8 in one unreproduced cell. INITIAL/WINDOW apply when =1.
ADAPTIVE_SPECULATIVE_TOKENS=0
ADAPTIVE_SPECULATIVE_TOKENS_INITIAL=3
ADAPTIVE_SPECULATIVE_TOKENS_WINDOW=32

# DFlash2 draft: required only when SPECULATOR=dflash2; leave empty under
# mtp. Snapshot dir on BOTH nodes; the MXFP8 variant's model.safetensors
# sha256 c033e03d47c7d5608596c8fc4e9336a1fe086eb781c08fe031be2bdea1614e58 is
# the qualified draft -- set DFLASH_WEIGHTS_SHA256 to have the launcher
# refuse anything else. Draft KV dtype: auto (BF16, qualified) or fp8.
DFLASH_MODEL_HOST_PATH=
DFLASH_WEIGHTS_SHA256=
DFLASH_KV_CACHE_DTYPE=auto
# MTP head backends (mtp only). humming / B12X are the canonical pair.
MTP_MOE_BACKEND=humming
MTP_ATTENTION_BACKEND=B12X

# Context ceiling. 262144 is the qualified value. Never `auto` (resolves to
# 1M and starves the pool). Must fit one request in the KV pool below.
MAX_MODEL_LEN=262144

# Concurrent sequences. A decode step is MAX_NUM_SEQS x (depth+1) tokens and
# must fit MAX_CUDAGRAPH_CAPTURE_SIZE: 8 x 4 = 32 <= 96. 16 seqs needs
# capture 128 and ~2 GiB more graph memory (OOMed at R12 with vision on).
MAX_NUM_SEQS=8

# Tokens per engine step = prefill chunk. 4096 is the qualified value;
# 8192 measured +15-25% prefill but ~+2.7 GiB transient activation peak.
MAX_NUM_BATCHED_TOKENS=4096

# Largest captured decode batch. 96 covers every depth at 8 seqs.
MAX_CUDAGRAPH_CAPTURE_SIZE=96

# FULL captures decode only (the GDN backend downgrades it to
# FULL_DECODE_ONLY; prefill runs eager). FULL_AND_PIECEWISE adds piecewise
# prefill graphs: part of the +15-25% prefill gain, costs ~2 GiB static.
# Other values: PIECEWISE, NONE.
CUDAGRAPH_MODE=FULL

# Admit new prefill only every N engine steps so a long prefill cannot
# starve an active decode (upstream #546: 43 -> 199 tok/s during a 64k
# prefill). 1 = every step (upstream's pre-#546 behavior).
PREFILL_SCHEDULE_INTERVAL=8

# r26 compute-share scheduler, an ALTERNATIVE to the interval above.
# Empty = off. To test: FAIRNESS_ENGINE=compute_share with
# PREFILL_COMPUTE_SHARE=0.40 (r26's qualified share) and interval 1.
# Other engine: micro_slicing. [r26 image]
FAIRNESS_ENGINE=
PREFILL_COMPUTE_SHARE=

# Recurrent-state retention for prefix caching. A checkpoint is a saved
# "resume here" state; GLM needs the recurrent (KDA) state as well as the
# attention KV, so matching tokens alone are not enough. Both policies need
# an exact token-prefix match and resident state.
#   request_boundaries (engine auto default; head-0905+, dflash2 too since
#     #682): checkpoints at the end of the leading SYSTEM/developer
#     instructions, the complete input prompt, and the committed response.
#     Fewest retained states; right for chat, shared instructions, agents.
#     Two prompts that diverge INSIDE a long user message find no nearby
#     checkpoint.
#   aligned: real checkpoints every recurrent block (256 tokens with the
#     2048/256 geometry below) including inside user messages -- two prompts
#     sharing 9,000 tokens resume from 8,960. For long documents or prompts
#     that share only part of a user turn. Costs more retained recurrent
#     states (cache-capacity pressure), not a prefix copy per bookmark.
#   auto: engine picks request_boundaries where supported, aligned otherwise.
# GPU-local cache in all cases -- nothing is written to disk.
RECURRENT_CHECKPOINT_POLICY=request_boundaries

# Paged-KV block for the public block table. 256 is validated; the hybrid
# alignment overrides the physical page anyway (4608 tokens coupled, or the
# split-page geometry). Upstream's TP2 launcher uses 16.
BLOCK_SIZE=256


# =============================================================================
# 3. MEMORY
# =============================================================================

# Pinned KV+recurrent pool in bytes. Bypasses profiling and makes
# GPU_MEMORY_UTILIZATION inert. 9 GiB on the original NVFP4 = 1,087,023
# tokens (~120k tokens per GiB); node static ~113 GiB + pin fully resident
# + ~2.5 GiB prefill transient must stay under 121.7. Measured hovering at
# 115.9 under bench (the pool fills only under long multi-user load).
KV_CACHE_MEMORY_BYTES=9663676416

# Inert while the pin is set; governs pool sizing only if the pin is removed
# (then GB10 refuses > ~0.913; page cache counts against CUDA free memory).
GPU_MEMORY_UTILIZATION=0.90

# fp8 is the qualified KV layout for B12X attention (engine selects the
# fp8_ds_mla format). r26 adds nvfp4_ds_mla (half the bytes; quality-gated).
KV_CACHE_DTYPE=fp8

# Memory preflight at --check: die (default) refuses to start when MemFree
# is short of what vLLM's own gate reads; warn proceeds anyway; off skips.
MEM_PREFLIGHT=die

# cgroup cap on the container so a runaway load kills the container, not
# the host. Empty = unlimited. Upstream's TP2 launcher uses 108.
CONTAINER_MEMORY_GB=


# =============================================================================
# 4. MULTIMODAL
# =============================================================================

# 0 serves images/video (the checkpoint is the vision-language variant);
# 1 skips the vision encoder cache and profile (~7% more KV at R12).
LANGUAGE_MODEL_ONLY=0

# 1 = cap items per PROMPT from MM_IMAGES/MM_VIDEOS (the whole chat history
# counts: an agent loop that returns screenshots hits the cap in a few
# turns); 0 = omit the cap (engine default 999 per modality, bounded only by
# MAX_MODEL_LEN). With the KV pin set the cap costs no static memory either
# way -- it only governs per-request preprocessing, encoder work and context.
LIMIT_MM=1

# Per-prompt caps when LIMIT_MM=1 (integers on purpose: JSON here loses its
# quotes when the file is sourced; the launcher builds the JSON). 16 images
# is comfortable for browsing/agent sessions; 0 disables a modality
# (MM_VIDEOS=0 drops the max-size video profile item).
MM_IMAGES=16
MM_VIDEOS=0

# CPU-side multimodal PROCESSOR cache: remembers preprocessed media so a
# repeated image/video skips resize/patchify. vLLM's default is 4 GiB of
# host RAM per process (x2: API server + engine) -- on unified memory that
# is the same pool as the KV cache. 0 disables it; prompts are unaffected,
# only repeated media is reprocessed. [engine flag; all images]
MM_PROCESSOR_CACHE_GB=0

# Vision encoder parallelism: data = each rank holds the full encoder and
# encodes its own items (no encoder collectives over RoCE); weights = the
# engine default, encoder weights split across ranks with collectives at
# every encoder layer. Empty = engine default.
MM_ENCODER_TP_MODE=data


# =============================================================================
# 5. KERNELS AND BACKENDS
# =============================================================================

# GB10 is sm_121. The launcher refuses anything else (sm_120a silently
# builds RTX Pro 6000 CuTeDSL kernels that fail at load).
CUTE_DSL_ARCH=sm_121a
FLASHINFER_CUDA_ARCH_LIST=12.1f

# 0 = FP4-activation MoE (qualified, engine default); 1 = older W4A16 path
# for an output-quality A/B.
VLLM_B12X_MOE_FP4_FORCE_A16=0

# FlashInfer startup autotune: 0 (the canonical GLM recipe's value). With
# B12X owning attention, MoE and linear kernels there is nothing of
# consequence for FlashInfer to tune; 1 costs startup time and JIT work.
# The --ir-op-priority.rms_norm / fused_add_rms_norm=vllm_c flags seen in
# the Qwen/DS4 launchers are already this fork's defaults (the boot log's
# kernel_config shows rms_norm=['vllm_c','native']); nothing to set.
ENABLE_FLASHINFER_AUTOTUNE=0

# Kernel backends, explicit. MoE: b12x (qualified; the engine default since
# r34/#728 -- upstream measured FlashInfer CUTLASS -> B12X +11.5% C1 on
# Qwen; other values humming, auto). Attention: B12X (GLM sparse-MLA + GDN;
# other value auto). Linear: b12x (auto may pick FlashInfer kernels not
# qualified on sm_121).
MOE_BACKEND=b12x
ATTENTION_BACKEND=B12X
LINEAR_BACKEND=b12x

# Quantization config class: modelopt_mixed (qualified for both NVFP4
# checkpoints); auto omits the flag so the checkpoint self-describes.
QUANTIZATION=modelopt_mixed

# KDA (GDN) prefill backend for the 34 KDA layers. flashkda = the in-tree
# extension (probe-image.sh confirms _flashkda_C built for sm_121; every
# measurement here used it). auto would fall back to Triton silently if the
# extension were missing. b12x = B12X native path: crashed on GB10 on
# 2026-09-04 (no GB10 profile entry; index-contiguity bug in the bind) --
# do not set until fixed. Other value: triton. [head-0903+]
KDA_PREFILL_BACKEND=flashkda

# KDA (GDN) decode kernel. Empty = the engine resolver (B12X live-tensor
# when eligible, Triton fallback otherwise -- never confirmed from a log).
# b12x pins the B12X kernel explicitly (upstream's TP2 launcher does).
# Other values: cuda, triton. [head-0903+]
GDN_DECODE_KERNEL=

# NVFP4 split-materialized MoE prefill (b12x #353) auto-fires on this
# model's shape. (measured, R33) -18% prefill on GB10 (32k 1,939 -> 1,537)
# -- but R33/R34's split path lacked the SwiGLU clamp (fixed in R35); the
# GB10 number predates the fix and must be re-measured on R35+ with 1.
# 0 keeps the monolithic path (the measured-safe value until then).
B12X_NVFP4_DYNAMIC_MATERIALIZED=0

# B12X kernel-policy engine: auto = GPU profile when a GB10 entry exists,
# heuristic otherwise (this is what printed "policy fallback ... no
# component entry" for kda_prefill); heuristic-only; preplanned-only.
B12X_POLICY_MODE=auto

# Luke's Spark decode defaults (2026-09-05). All four default to 1 in that
# tree; explicit here so an A/B is one edit. Measured by the author on TP2
# GB10 single-stream: 28.5 -> 33.4 tok/s (128-token input), 22.1 -> 25.5
# (4096). Commit caveat: a long-context JSON-copying regression is under
# investigation -- run Estonia; VLLM_MXFP8_LM_HEAD=0 is the revert.
#   MXFP8_LM_HEAD: quantize the target vocabulary projection (MXFP8)
#   LM_HEAD_A16: BF16 activations for the quantized head
#   MTP_NVFP4_LM_HEAD: NVFP4 draft-only copy of the head for the MTP head
#   GDN_SPEC_DECODE_METADATA_FASTPATH: share KDA query/count metadata
#     across layers per step (less per-step CPU work)
# [head-0905+; earlier images log "Unknown vLLM environment variable"]
VLLM_MXFP8_LM_HEAD=1
VLLM_LM_HEAD_A16=1
VLLM_MTP_NVFP4_LM_HEAD=1
VLLM_GDN_SPEC_DECODE_METADATA_FASTPATH=1

# torch.compile level: empty = none (CompilationMode.NONE + CUDA graphs,
# the qualified path); 0-3 passes -O<N>. Inductor cannot fuse into B12X or
# vLLM custom ops, so the expected gain is small; compile time on Grace is
# minutes. A/B only.
COMPILATION_LEVEL=

# Sampling defaults: auto = the checkpoint's generation_config.json (what
# every benchmark here ran under); vllm = engine-neutral defaults (T=1, no
# truncation -- lowers speculative acceptance).
GENERATION_CONFIG=auto

# Sampling overrides. Empty = the checkpoint's generation_config.json via
# GENERATION_CONFIG=auto -- and since 2026-09-10 the original NVFP4's
# generation_config carries the publisher's temperature 1.0 / top_p 0.95
# (commit 4b10bdd), so nothing needs forcing. Set these only to deviate
# (or for a checkpoint whose config lacks them). The launcher builds
# --override-generation-config from whichever are set; per-request
# sampling fields still win. Accepted keys: temperature, top_p, top_k
# (integer; GLM ships no fixed top-k), min_p, repetition_penalty.
SAMPLING_TEMPERATURE=
SAMPLING_TOP_P=
SAMPLING_TOP_K=
SAMPLING_MIN_P=
SAMPLING_REPETITION_PENALTY=

# Chat-template defaults (r30): reasoning_effort high (not max; still a
# thinking mode; low|max per request), clear_thinking=0 keeps the client's
# historical reasoning in the rendered prompt (the agent profile; clients
# must send it back in assistant messages). Empty = the template's default.
REASONING_EFFORT=high
CLEAR_THINKING=0

# Optional custom chat template (e.g. reasoning=high default). Empty = the
# checkpoint's template. Mounted read-only at /models/chat_template.jinja.
CHAT_TEMPLATE_HOST_PATH=

# Host directory for torch profiler traces; empty = profiling disabled.
# Set to enable POST /start_profile and /stop_profile (mounted at /profiles).
TORCH_PROFILE_HOST_DIR=

# Split cache pages: target (attention) block, recurrent (KDA/mamba)
# NOTE: vLLM logs "Unknown vLLM environment variable" for these two because
# they are read directly by platforms/interface.py, not via envs.py. The
# warning is cosmetic -- the boot's "Using split GLM-5.3 cache pages" line
# is the proof they are honored.
# checkpoint block, and the public block size (BLOCK_SIZE above). On
# head-0906+ (#669 ported #646's fine-grained hits and the recurrent-
# divides-target rule) all three are explicit for every speculator. This is
# El8's geometry: 2048/256/256 -- target pages sized to the recurrent slot
# (no slot inflation), recurrent checkpoints every 256 tokens, block-table
# unit 256. Upstream's TP2 launcher runs 512/512/512.
# On OLDER pins the engine reads the PRESENCE of these two variables:
#   pre-#669 mtp -> remove both (512 inflated every slot 8x; 4096 = no gain)
#   pre-#669 dflash2 -> 4096/4096 exactly (anything else fails at boot)
# --check warns on the known-bad combinations.
VLLM_GLM53_SPLIT_TARGET_BLOCK_SIZE=2048
VLLM_GLM53_SPLIT_MAMBA_BLOCK_SIZE=256


# =============================================================================
# 6. COLLECTIVES -- RoCEnante (b12x one-shot RoCE collectives)
# =============================================================================

# 1 routes TP all-reduces <= ALLREDUCE_MAX_SIZE bytes and all-gather shards
# <= ALLGATHER_MAX_SIZE through b12x.comm.roce; NCCL keeps the rest.
# (measured) decode unchanged versus NCCL at TP2 (2 MiB cutoff); raising the
# cutoff to 16 MiB puts the 4096-token prefill chunk's per-layer reduce
# (4096 x 2048 x 2 B = 16 MiB exactly) on RoCE: prefill 8k +19%, 32k-128k
# +1-4%. Dooner's TP2 profile uses the same value. 0 = NCCL for everything.
# The proxy compiles at first boot into B12X_ROCE_CACHE_DIR (keep under
# /cache). HCA and GID fall back to NCCL_IB_HCA / NCCL_IB_GID_INDEX.
# [R17-RoCE / head images; the R12 image ignores these]
VLLM_ENABLE_ROCE_ALLREDUCE=1
VLLM_ROCE_ALLREDUCE_MAX_SIZE=16777216
VLLM_ROCE_ALLGATHER_MAX_SIZE=16777216
B12X_ROCE_CACHE_DIR=/cache/jit/b12x-roce

# The B12X PCIe allreduce is a single-node PCIe P2P path. On a pair every
# TP allreduce crosses the CX7 link; the image bakes 1, this file overrides
# to 0 and the launcher refuses 1.
VLLM_ENABLE_PCIE_ALLREDUCE=0


# =============================================================================
# 7. LOADER
# =============================================================================

# Loader. instanttensor: ~2.5 GB/s, the loader behind every measurement
# here. b12x (Luke's Spark loader, 30 s loads, needs VLLM_PLUGINS=b12x_loader)
# (measured) still costs steady-state throughput on GB10: write-combined
# storage -30% prefill; managed storage -12% c1 steps/s. Reported; switch
# back once a build matches instanttensor on the bench. Other values:
# fastsafetensors, auto.
LOAD_FORMAT=instanttensor

# InstantTensor-ONLY staging bounds (read by the instanttensor library; inert
# under b12x/fastsafetensors/auto -- the launcher passes them only when
# LOAD_FORMAT=instanttensor). BUFFER_SIZE 1.25 GiB covers the largest tensor
# (1,268,776,960 B); 64 MiB just got auto-enlarged every boot. COPY: auto =
# engine default; 0 passes instanttensor_copy:false (bounded unified-memory
# loading, upstream's TP2 setting) [head-0903+]; 1 forces copies.
INSTANTTENSOR_BUFFER_SIZE=1342177280
INSTANTTENSOR_IO_DEPTH=3
INSTANTTENSOR_CONCURRENCY=1
INSTANTTENSOR_CHUNK_SIZE=8388608
# 0/1 are rejected by pins >= 6575b5ac (option removed); leave auto. Never
# put comments after a value: docker --env-file passes them into the container.
INSTANTTENSOR_COPY=auto
INSTANTTENSOR_BACKEND=BUFFERED
SAFETENSORS_FAST_GPU=1

# Fully offline: the model resolves from the mount only.
HF_HOME=/root/.cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
VLLM_NO_USAGE_STATS=1
# vLLM plugins: set b12x_loader only with LOAD_FORMAT=b12x; empty = none.
VLLM_PLUGINS=
VLLM_WORKER_MULTIPROC_METHOD=spawn

# Compat shim first (the image's CUDA is newer than what the host driver
# exports -- without it every process dies at import with "undefined symbol:
# cuTensorMapEncodeTiled"), then the patched NCCL for the switchless pair.
# The paths are IMAGE-FLAVOR specific; exactly one block is active. The
# launcher verifies every LD_PRELOAD path exists inside the image at --check.
#
# cu132 images (build-spark-cu132.sh: R12 .. R35 on CUDA 13.2, NCCL 2.30.4):
LD_PRELOAD=/usr/local/cuda/compat/libcuda.so.1:/opt/libnccl-local-inference.so.2.30.4
VLLM_NCCL_SO_PATH=/opt/libnccl-local-inference.so.2.30.4
NCCL_LOCAL_INFERENCE_PATH=/opt/libnccl-local-inference.so.2.30.4
NCCL_PR2127_PATH=/opt/libnccl-local-inference.so.2.30.4
#
# cu133 images (build-spark-cu133.sh: NGC-based foundation, NCCL 2.31.2 at
# /opt/local-inference/nccl/lib; the image bakes these NCCL values itself).
# The NGC base ships its forward-compat libcuda under
# /usr/local/cuda/compat/lib.real/ -- confirm with
#   docker run --rm --entrypoint ls <image> /usr/local/cuda/compat/lib.real
# and drop the shim from LD_PRELOAD if the host driver already satisfies
# CUDA 13.3 (then the plain NCCL preload is enough).
#LD_PRELOAD=/usr/local/cuda/compat/lib.real/libcuda.so.1:/opt/local-inference/nccl/lib/libnccl.so.2.31.2
#VLLM_NCCL_SO_PATH=/opt/local-inference/nccl/lib/libnccl.so.2.31.2
#NCCL_LOCAL_INFERENCE_PATH=/opt/local-inference/nccl/lib/libnccl.so.2.31.2
#NCCL_PR2127_PATH=/opt/local-inference/nccl/lib/libnccl.so.2.31.2
TORCH_USE_RTLD_GLOBAL=1

# JIT toolchain: Triton uses the image's CUDA 13.2 ptxas, not its bundled one.
CUDA_HOME=/usr/local/cuda
TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas

# Allocator: expandable segments (required with NCCL_CUMEM_ENABLE=0 below).
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_DEVICE_MAX_CONNECTIONS=32

# Grace CPU threads for torch. 2 avoids torch's spin-wait warning under
# serving; upstream's TP2 launcher uses 16 (unmeasured difference).
OMP_NUM_THREADS=2

# docker or podman.
CONTAINER_RUNTIME=docker


# =============================================================================
# 8. FABRIC -- RoCEv2 over the direct ConnectX-7 link (launcher-enforced)
# =============================================================================

# RoCE presents IB semantics over Ethernet: IB is correct. The image bakes
# NCCL_IB_DISABLE=1 for single-node boxes; this overrides it.
NCCL_NET=IB
NCCL_NET_PLUGIN=none
NCCL_IB_DISABLE=0

# Single-rail profile (validated): 0/0. Dual-rail (both CX7 ports cabled):
# MERGE_NICS=1 + SUBNET_AWARE_ROUTING=1 + both rails in NCCL_IB_HCA for
# ~2x cross-node bandwidth; the launcher rejects mixed settings. Upstream's
# single-rail launcher runs SUBNET_AWARE_ROUTING=1 with MERGE_NICS=0
# (allowed, warned, unmeasured here).
NCCL_IB_SUBNET_AWARE_ROUTING=0
NCCL_IB_MERGE_NICS=0

# Qualified protocol/topology set for the direct-cable pair.
NCCL_PROTO=LL,LL128,Simple
NCCL_P2P_LEVEL=SYS
NCCL_CROSS_NIC=1

# NCCL's CUDA VMM allocator conflicts with expandable_segments: keep 0.
NCCL_CUMEM_ENABLE=0

# Grace's unified layout defeats NCCL's NUMA guesses.
NCCL_IGNORE_CPU_AFFINITY=1

# WARN for serving. INFO names the transport per channel (NET/IB vs
# NET/Socket) when debugging a hang or checking RoCE is in use.
NCCL_DEBUG=WARN
